<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.ReadsAppointmentsOverviewPage"
             x:Name="Root"
             x:DataType="vm:ReadsAppointmentsOverviewViewModel"
             BackgroundColor="#F5F7FA">

    <ContentPage.Resources>
        <conv:TabTextColorConverter x:Key="TabTextColor" />
    </ContentPage.Resources>

    <Grid Padding="14,16,14,12"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="14">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Border BackgroundColor="#176B38" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" Padding="12,10">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;"
                            FontSize="21" TextColor="#087A3D"
                            BackgroundColor="#F4C400" CornerRadius="9"
                            WidthRequest="38" HeightRequest="38" Padding="0"
                            Command="{Binding GoBackCommand}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="All Appointments" FontSize="19"
                               FontAttributes="Bold" TextColor="#F4C400" />
                        <Label Text="Clinic-wide overview across all service types"
                               FontSize="11" TextColor="#E9F3EC" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <BoxView HeightRequest="5" Color="#F4C400"/>
        </VerticalStackLayout>
        <!-- Appointment filters -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               BorderColor="#E6EAF0"
               CornerRadius="14"
               Padding="6"
               HasShadow="False">
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="5"
                                     Padding="4,7">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                              CommandParameter="All" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="All"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{Binding IsAllTab, Converter={StaticResource TabTextColor}}" />
                    <BoxView HeightRequest="2"
                             WidthRequest="30"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsAllTab}"
                             Color="#F4C400" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="5"
                                     Padding="4,7">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                              CommandParameter="Upcoming" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Upcoming"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{Binding IsUpcomingTab, Converter={StaticResource TabTextColor}}" />
                    <BoxView HeightRequest="2"
                             WidthRequest="60"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsUpcomingTab}"
                             Color="#F4C400" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="5"
                                     Padding="4,7">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}"
                                              CommandParameter="Past" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Past"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{Binding IsPastTab, Converter={StaticResource TabTextColor}}" />
                    <BoxView HeightRequest="2"
                             WidthRequest="30"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsPastTab}"
                             Color="#F4C400" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Appointment list and empty state -->
        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Appointments}"
                            IsVisible="{Binding HasAppointments}"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReadsAppointmentOverviewItem">
                        <Frame BackgroundColor="White"
                               BorderColor="#E2E8EF"
                               CornerRadius="16"
                               Padding="0"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="0">

                                <!-- Patient, service, and status -->
                                <VerticalStackLayout Padding="16,15,16,12"
                                                     Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding PatientName}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="#12212E"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />

                                        <Frame Grid.Column="1"
                                               BackgroundColor="{Binding StatusColor}"
                                               CornerRadius="12"
                                               Padding="10,5"
                                               HasShadow="False"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding StatusDisplay}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                        </Frame>
                                    </Grid>

                                    <Label FontSize="13"
                                           TextColor="#526171"
                                           LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding ServiceType}"
                                                      FontAttributes="Bold" />
                                                <Span Text="  •  " />
                                                <Span Text="{Binding SubService}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Date and time -->
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <Frame Grid.Column="0"
                                               BackgroundColor="#F5F7FA"
                                               CornerRadius="10"
                                               Padding="10,8"
                                               HasShadow="False">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="DATE"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="#8A96A3" />
                                                <Label Text="{Binding DateDisplay}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#334155" />
                                            </VerticalStackLayout>
                                        </Frame>

                                        <Frame Grid.Column="1"
                                               BackgroundColor="#F5F7FA"
                                               CornerRadius="10"
                                               Padding="10,8"
                                               HasShadow="False">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="TIME"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="#8A96A3" />
                                                <Label Text="{Binding TimeDisplay}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#334155" />
                                            </VerticalStackLayout>
                                        </Frame>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Separate review area for pending requests -->
                                <VerticalStackLayout IsVisible="{Binding CanApprove}"
                                                     BackgroundColor="#FFF9ED"
                                                     Padding="16,12,16,15"
                                                     Spacing="8">
                                    <Label Text="NEW REQUEST · NEEDS REVIEW"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#A87518" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Grid.Column="0"
                                                Text="Decline"
                                                IsVisible="{Binding CanDecline}"
                                                Command="{Binding Source={x:Reference Root},
                                                                  Path=BindingContext.DeclineAppointmentCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="White"
                                                BorderColor="#D86A63"
                                                BorderWidth="1"
                                                TextColor="#B3443D"
                                                FontAttributes="Bold"
                                                CornerRadius="12"
                                                HeightRequest="46"
                                                Padding="10,0" />
                                        <Button Grid.Column="1"
                                                Text="Approve Request"
                                                IsVisible="{Binding CanApprove}"
                                                Command="{Binding Source={x:Reference Root},
                                                                  Path=BindingContext.ApproveAppointmentCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#087A3D"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                CornerRadius="12"
                                                HeightRequest="46"
                                                Padding="10,0" />
                                    </Grid>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding HasAppointments,
                                                    Converter={StaticResource BoolInverter}}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="8"
                                 Padding="24">
                <Label Text="&#128197;"
                       FontSize="40"
                       HorizontalOptions="Center"
                       TextColor="#B8C2CC" />
                <Label Text="No appointments here"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#526171"
                       HorizontalOptions="Center" />
                <Label Text="Appointments for this filter will appear here."
                       FontSize="12"
                       TextColor="#8793A0"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>