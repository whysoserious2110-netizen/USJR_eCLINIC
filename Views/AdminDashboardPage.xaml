<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.AdminDashboardPage"
             x:Name="Root"
             x:DataType="vm:AdminDashboardViewModel"
             Title="Clinic Administration"
             BackgroundColor="#F7F8F6"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,5,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
              BackgroundColor="#087A3D" Padding="18,13">
            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                <Label Text="Adelante, Administrator!" FontSize="20" FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding CurrentDateText}" FontSize="14" TextColor="#E8F3EC" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Settings" Command="{Binding OpenSettingsCommand}"
                    BackgroundColor="Transparent" TextColor="White" FontSize="13" Padding="8,4"
                    VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Sign out" Command="{Binding LogoutCommand}"
                    BackgroundColor="#F4C400" TextColor="#087A3D" FontAttributes="Bold"
                    FontSize="13" Padding="10,6" CornerRadius="10" VerticalOptions="Center" />
        </Grid>
        <BoxView Grid.Row="1" Color="#F4C400" />

        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,20" Spacing="17">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Clinic Overview" FontSize="21" FontAttributes="Bold" TextColor="#1F2933" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="10">
                                <Border WidthRequest="154" Padding="14,12" BackgroundColor="White" Stroke="#E5EAE6" StrokeShape="RoundRectangle 16">
                                    <Border.Shadow><Shadow Brush="#18000000" Offset="0,2" Radius="8" /></Border.Shadow>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="📋" FontSize="20" />
                                        <Label Text="PENDING APPROVALS" FontSize="11" FontAttributes="Bold" TextColor="#667085" />
                                        <Label Text="{Binding PendingApprovalsCount}" FontSize="28" FontAttributes="Bold" TextColor="#087A3D" />
                                        <Label Text="Faculty &amp; Non-Teaching" FontSize="12" TextColor="#667085" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border WidthRequest="154" Padding="14,12" BackgroundColor="White" Stroke="#E5EAE6" StrokeShape="RoundRectangle 16">
                                    <Border.Shadow><Shadow Brush="#18000000" Offset="0,2" Radius="8" /></Border.Shadow>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="👥" FontSize="20" />
                                        <Label Text="ACTIVE CLINIC STAFF" FontSize="11" FontAttributes="Bold" TextColor="#667085" />
                                        <Label Text="{Binding ActiveStaffCount}" FontSize="28" FontAttributes="Bold" TextColor="#087A3D" />
                                        <Label Text="Nurse · Doctor · Dentist · READS" FontSize="11" TextColor="#667085" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border WidthRequest="154" Padding="14,12" BackgroundColor="White" Stroke="#E5EAE6" StrokeShape="RoundRectangle 16">
                                    <Border.Shadow><Shadow Brush="#18000000" Offset="0,2" Radius="8" /></Border.Shadow>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="🗓️" FontSize="20" />
                                        <Label Text="STAFF ON DUTY TODAY" FontSize="11" FontAttributes="Bold" TextColor="#667085" />
                                        <Label Text="{Binding StaffOnDutyCount}" FontSize="28" FontAttributes="Bold" TextColor="#087A3D" />
                                        <Label Text="Based on today's schedules" FontSize="12" TextColor="#667085" />
                                    </VerticalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <Grid x:Name="DashboardSections" ColumnDefinitions="*" RowDefinitions="Auto,Auto"
                          RowSpacing="14" ColumnSpacing="14">
                        <Border x:Name="ApprovalsPanel" Grid.Row="0" Grid.Column="0" Padding="16"
                                BackgroundColor="White" Stroke="#E5EAE6" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#14000000" Offset="0,2" Radius="8" /></Border.Shadow>
                            <VerticalStackLayout Spacing="11">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Pending account approvals" FontSize="18" FontAttributes="Bold" TextColor="#1F2933" />
                                        <Label Text="Faculty and Non-Teaching registrations" FontSize="13" TextColor="#667085" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="Review" FontSize="12" FontAttributes="Bold" TextColor="#087A3D" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding ApprovalPreviewEmptyMessage}" IsVisible="{Binding IsApprovalPreviewEmpty}"
                                       FontSize="14" TextColor="#667085" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingApprovalPreview}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StaffIdReviewItem">
                                            <Border Padding="11,9" BackgroundColor="#F7F8F6" Stroke="#EDF0ED" StrokeShape="RoundRectangle 12">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding FullName}" FontSize="15" FontAttributes="Bold" TextColor="#1F2933" />
                                                        <Label Text="{Binding Role}" FontSize="13" TextColor="#087A3D" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1" Text="{Binding IdNumber}" FontSize="12" TextColor="#667085" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Text="View account approvals" Command="{Binding OpenAccountApprovalsCommand}"
                                        BackgroundColor="#087A3D" TextColor="White" FontAttributes="Bold"
                                        CornerRadius="11" HeightRequest="46" />
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="StaffPanel" Grid.Row="1" Grid.Column="0" Padding="16"
                                BackgroundColor="White" Stroke="#E5EAE6" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#14000000" Offset="0,2" Radius="8" /></Border.Shadow>
                            <VerticalStackLayout Spacing="11">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Today's clinic staff" FontSize="18" FontAttributes="Bold" TextColor="#1F2933" />
                                        <Label Text="Scheduled team members and duty hours" FontSize="13" TextColor="#667085" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="Today" FontSize="12" FontAttributes="Bold" TextColor="#087A3D" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding StaffPreviewEmptyMessage}" IsVisible="{Binding IsStaffPreviewEmpty}"
                                       FontSize="14" TextColor="#667085" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding StaffOnDutyPreview}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ClinicStaffScheduleDisplay">
                                            <Border Padding="11,9" BackgroundColor="#F7F8F6" Stroke="#EDF0ED" StrokeShape="RoundRectangle 12">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding FullName}" FontSize="15" FontAttributes="Bold" TextColor="#1F2933" />
                                                        <Label Text="{Binding Role}" FontSize="13" TextColor="#087A3D" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1" Text="{Binding ScheduleText}" FontSize="12" TextColor="#667085"
                                                           VerticalOptions="Center" HorizontalTextAlignment="End" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Text="View staff schedules" Command="{Binding OpenStaffSchedulesCommand}"
                                        BackgroundColor="White" TextColor="#087A3D" BorderColor="#087A3D" BorderWidth="1"
                                        CornerRadius="11" HeightRequest="44" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" BackgroundColor="White" Padding="4,8"
              ColumnSpacing="2">
            <Button Text="Dashboard" Command="{Binding LoadCommand}" BackgroundColor="Transparent"
                    TextColor="#087A3D" FontAttributes="Bold" FontSize="11" Padding="1,8" />
            <Button Grid.Column="1" Text="Approvals" Command="{Binding OpenAccountApprovalsCommand}"
                    BackgroundColor="Transparent" TextColor="#667085" FontSize="11" Padding="1,8" />
            <Button Grid.Column="2" Text="Staff" Command="{Binding OpenStaffManagementCommand}"
                    BackgroundColor="Transparent" TextColor="#667085" FontSize="11" Padding="1,8" />
            <Button Grid.Column="3" Text="Schedules" Command="{Binding OpenStaffSchedulesCommand}"
                    BackgroundColor="Transparent" TextColor="#667085" FontSize="11" Padding="1,8" />
        </Grid>
    </Grid>
</ContentPage>
