<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.DoctorProfilePage"
             x:DataType="vm:DoctorProfileViewModel"
             BackgroundColor="#F7F8FA">

    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,30" Spacing="20">

            <Grid RowDefinitions="Auto,7" Margin="-20,-50,-20,0">
    <Border Grid.Row="0" BackgroundColor="#176B38" StrokeThickness="0"
            StrokeShape="Rectangle" Padding="18,50,18,14">
        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0" Text="&#8592;" FontSize="{StaticResource Typography.PageTitle}"
                    TextColor="#087A3D" BackgroundColor="#F4C400"
                    CornerRadius="9" WidthRequest="40" HeightRequest="40"
                    Padding="0" Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="Doctor Profile" FontSize="{StaticResource Typography.Section}"
                   FontAttributes="Bold" TextColor="#F4C400"
                   VerticalOptions="Center" />
            <Label Grid.Column="2" Text="Edit" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold"
                   TextColor="#F4C400" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleEditCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Border>
    <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
</Grid>

            <VerticalStackLayout HorizontalOptions="Fill" Spacing="8">
                <Frame WidthRequest="80" HeightRequest="80" CornerRadius="40" Padding="0"
                       HorizontalOptions="Center"
                       BackgroundColor="#E2E6EA" HasShadow="False" IsClippedToBounds="True">
                    <Grid>
                        <Label Text="&#128100;" FontSize="{StaticResource Typography.Display}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#9AA4AE"/>
                        <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}" Aspect="AspectFill"/>
                    </Grid>
                </Frame>

                <Label Text="Change photo" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       TextColor="#0F9B8E">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePhotoCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="{Binding FullName}" FontSize="{StaticResource Typography.Section}" FontAttributes="Bold"
                       TextColor="#12212E" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Frame BackgroundColor="#D5F5EF" Padding="10,3" CornerRadius="10" HasShadow="False"
                       HorizontalOptions="Center" WidthRequest="153">
                    <Label Text="DOCTOR" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold"
                           TextColor="#0F9B8E" HorizontalTextAlignment="Center" />
                </Frame>
            </VerticalStackLayout>

            <!-- Professional Info -->
            <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Professional Information" FontAttributes="Bold" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Full Name" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding FullName}" IsEnabled="{Binding IsEditing}" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Specialization" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding Specialization}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., General Medicine" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="PRC License No." FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                            <Entry Text="{Binding LicenseNumber}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., PRC-0123456" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Years of Experience" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                            <Entry Text="{Binding YearsOfExperience}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., 8" Keyboard="Numeric" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Department / Assigned Clinic" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding Department}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., Clinic - Medical" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Contact Info -->
            <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Contact Information" FontAttributes="Bold" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Label Text="{Binding Email}" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mobile Number" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding MobileNumber}" IsEnabled="{Binding IsEditing}" Placeholder="+63 9XX XXX XXXX" Keyboard="Telephone" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Schedule -->
            <!-- Schedule -->
            <!-- Clinic Information -->
            <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Clinic Information" FontAttributes="Bold" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Clinic" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding Department}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., USJ-R Clinic" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Position" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding Position}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., University Physician" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Consultation Schedule" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding ConsultationSchedule}" IsEnabled="{Binding IsEditing}"
                   Placeholder="e.g., Monday – Friday" FontSize="{StaticResource Typography.Body}" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Status" FontSize="{StaticResource Typography.Caption}" TextColor="#9AA4AE"/>
                        <Frame BackgroundColor="#D5F5EF" Padding="10,4" CornerRadius="10" HasShadow="False" HorizontalOptions="Start">
                            <Label Text="{Binding EmploymentStatus}" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#0F9B8E"/>
                        </Frame>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Changes"
                    Command="{Binding SaveCommand}"
                    IsVisible="{Binding IsEditing}"
                    BackgroundColor="#0F9B8E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>

            <Button Text="Log Out"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource LogoutButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
