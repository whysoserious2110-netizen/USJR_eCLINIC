<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             BackgroundColor="#2C9057">

    <Grid RowDefinitions="*, Auto" Padding="40,0">

        <VerticalStackLayout Grid.Row="0"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"
                              Spacing="20">
            <Image
    Source="eclinic.png"
    WidthRequest="180"
    HeightRequest="180"
    Aspect="AspectFit"
    HorizontalOptions="Center"
    Margin="0,0,0,0" />

            <Label
                    FontSize="27"
                    FontFamily="GeistBold"
    
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="NoWrap">
                        <Label.FormattedText>
                        <FormattedString>
                        <Span Text="USJ-R " TextColor="#36C65B" />
                        <Span Text="e-Clinic" TextColor="#FFD000" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="Your Health, Our Priority"
                   FontSize="15"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <Button Text="Sign in"
                    Command="{Binding SignInCommand}"
                    BackgroundColor="#176519"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="54"
                    WidthRequest="260"
                    Margin="0,20,0,0"/>
            

        </VerticalStackLayout>

        <Label Grid.Row="1"
               Text="UNIVERSITY OF SAN JOSE - RECOLETOS"
               FontSize="11"
               CharacterSpacing="1"
               TextColor="LightGreen"
               HorizontalOptions="Center"
               Margin="0,0,0,30"/>

    </Grid>
</ContentPage>