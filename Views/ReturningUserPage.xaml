<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
    x:Class="USJR_eCLINIC.Views.ReturningUserPage"
    x:DataType="vm:ReturningUserViewModel"
    BackgroundColor="#F7F8FA">

    <Grid Padding="30,50,30,30">

        <ScrollView>

            <VerticalStackLayout
                VerticalOptions="Center"
                Spacing="20">

                <!-- Clinic logo -->
                <Frame
                    BackgroundColor="#D5F5EF"
                    WidthRequest="84"
                    HeightRequest="84"
                    CornerRadius="22"
                    Padding="0"
                    HasShadow="False"
                    HorizontalOptions="Center">

                    <Label
                        Text="&#128737;"
                        FontSize="38"
                        TextColor="#0F9B8E"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                </Frame>

                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="{Binding WelcomeText}"
                        FontSize="29"
                        FontAttributes="Bold"
                        TextColor="#12212E"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Unlock your USJ-R e-Clinic account"
                        FontSize="13"
                        TextColor="#6B7684"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- Remembered account -->
                <Frame
                    IsVisible="{Binding HasRememberedUser}"
                    BackgroundColor="White"
                    BorderColor="#E2E6EA"
                    CornerRadius="18"
                    Padding="20"
                    HasShadow="False">

                    <VerticalStackLayout Spacing="14">

                        <!-- Profile picture -->
                        <Frame
                            WidthRequest="82"
                            HeightRequest="82"
                            CornerRadius="41"
                            Padding="0"
                            HasShadow="False"
                            BackgroundColor="#E2E6EA"
                            IsClippedToBounds="True"
                            HorizontalOptions="Center">

                            <Grid>

                                <Label
                                    Text="&#128100;"
                                    FontSize="34"
                                    TextColor="#9AA4AE"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                                <Image
                                    Source="{Binding ProfileImagePath,
                                        Converter={StaticResource ImagePathConv}}"
                                    Aspect="AspectFill"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"/>

                            </Grid>

                        </Frame>

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="{Binding UserName}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#12212E"
                                HorizontalTextAlignment="Center"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="{Binding Role}"
                                FontSize="12"
                                TextColor="#0F9B8E"
                                HorizontalOptions="Center"/>

                        </VerticalStackLayout>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EEF1F3"/>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="{Binding IdLabel}"
                                FontSize="12"
                                TextColor="#6B7684"/>

                            <Label
                                Grid.Column="1"
                                Text="{Binding MaskedId}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#12212E"/>

                        </Grid>

                    </VerticalStackLayout>

                </Frame>

                <!-- Unlock -->
                <Button
                    Text="{Binding UnlockButtonText}"
                    Command="{Binding UnlockCommand}"
                    IsEnabled="{Binding IsLoading,
                        Converter={StaticResource BoolInverter}}"
                    BackgroundColor="#0F9B8E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="54"/>

                <!-- Loading -->
                <ActivityIndicator
                    IsVisible="{Binding IsLoading}"
                    IsRunning="{Binding IsLoading}"
                    Color="#0F9B8E"
                    WidthRequest="30"
                    HeightRequest="30"
                    HorizontalOptions="Center"/>

                <!-- Password fallback -->
                <Button
                    Text="Use password instead"
                    Command="{Binding UsePasswordCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#0F9B8E"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    HeightRequest="48"
                    BorderColor="#0F9B8E"
                    BorderWidth="1"/>

                <Label
                    Text="Not you? Use another account"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#6B7684"
                    HorizontalOptions="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding UseAnotherAccountCommand}"/>
                    </Label.GestureRecognizers>

                </Label>

                <Label
                    Text="Your password is not stored on this device."
                    FontSize="11"
                    TextColor="#9AA4AE"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0"/>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>