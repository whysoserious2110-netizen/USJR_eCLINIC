<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
    x:Class="USJR_eCLINIC.Views.ReturningUserPage"
    x:DataType="vm:ReturningUserViewModel"
    BackgroundColor="#F4F7F4"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="24,35" RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout VerticalOptions="Center" Spacing="20">
                <Border WidthRequest="82"
                        HeightRequest="82"
                        Padding="0"
                        BackgroundColor="#E4F1E7"
                        Stroke="#C7E0CC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 41"
                        HorizontalOptions="Center">
                    <Label Text="+"
                           FontSize="62"
                           FontAttributes="Bold"
                           TextColor="#176B38"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Margin="0,-6,0,0" />
                </Border>

                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding WelcomeText}"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="#173323"
                           HorizontalOptions="Center" />
                    <Label Text="Sign in with your password to continue."
                           FontSize="14"
                           TextColor="#718075"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasRememberedUser}"
                        BackgroundColor="White"
                        Stroke="#DCE5DD"
                        StrokeShape="RoundRectangle 18"
                        Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Border WidthRequest="78"
                                HeightRequest="78"
                                Padding="0"
                                BackgroundColor="#E4F1E7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 39"
                                HorizontalOptions="Center">
                            <Grid>
                                <Label Text="●"
                                       FontSize="42"
                                       TextColor="#9AAC9E"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding UserName}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#173323"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Role}"
                                   FontSize="13"
                                   TextColor="#176B38"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#E8EEE9" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding IdLabel}"
                                   FontSize="12"
                                   TextColor="#718075" />
                            <Label Grid.Column="1"
                                   Text="{Binding MaskedId}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#173323" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Sign in with password"
                        Command="{Binding UnlockCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverter}}"
                        BackgroundColor="#176B38"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="13"
                        HeightRequest="54" />

                <ActivityIndicator IsVisible="{Binding IsLoading}"
                                   IsRunning="{Binding IsLoading}"
                                   Color="#176B38"
                                   HorizontalOptions="Center" />

                <Label Text="Use another account"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#176B38"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding UseAnotherAccountCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="1"
               Text="Your password is never saved on this device."
               FontSize="11"
               TextColor="#89968B"
               HorizontalTextAlignment="Center"
               Margin="0,15,0,5" />
    </Grid>
</ContentPage>
