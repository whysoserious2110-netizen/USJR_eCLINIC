<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.PrescriptionsPage"
             x:DataType="vm:PrescriptionsViewModel"
             BackgroundColor="#F7F8FA">

    <VerticalStackLayout Padding="20,50,20,20" Spacing="16">

        <Grid ColumnDefinitions="Auto,*">
            <Label Grid.Column="0" Text="&#8592;" FontSize="22" TextColor="#0F9B8E" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Prescriptions" FontSize="20" FontAttributes="Bold"
                   TextColor="#12212E" Margin="10,0,0,0" VerticalOptions="Center"/>
        </Grid>

        <VerticalStackLayout IsVisible="{Binding HasPrescriptions, Converter={StaticResource BoolInverter}}"
                              VerticalOptions="Center" Margin="0,60,0,0" Spacing="10">
            <Label Text="&#128138;" FontSize="40" HorizontalOptions="Center" TextColor="#C7CDD3"/>
            <Label Text="No prescriptions yet" FontSize="15" FontAttributes="Bold" TextColor="#6B7684" HorizontalOptions="Center"/>
            <Label Text="Your prescribed medications will appear here after a clinic visit." FontSize="12" TextColor="#9AA4AE"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="30,0,30,0"/>
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Prescriptions}" IsVisible="{Binding HasPrescriptions}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PrescriptionListItem">
                    <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14"
                           Padding="16" Margin="0,0,0,12" HasShadow="False">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding MedicineName}" FontAttributes="Bold" FontSize="15" TextColor="#12212E"/>
                                <Frame Grid.Column="1" BackgroundColor="{Binding LabelColor}" CornerRadius="10"
                                       Padding="10,3" HasShadow="False">
                                    <Label Text="{Binding LabelText}" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                </Frame>
                            </Grid>

                            <Label Text="{Binding Dosage}" FontSize="13" TextColor="#6B7684"/>

                            <Label Text="{Binding Instructions}" FontSize="12" TextColor="#9AA4AE"
                                   IsVisible="{Binding Instructions, Converter={StaticResource StringNotEmpty}}"/>

                            <Label Text="{Binding DateDisplay}" FontSize="11" TextColor="#C7CDD3"/>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>