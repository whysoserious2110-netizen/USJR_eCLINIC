<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.AdminPatientsListPage"
             x:Name="Root"
             x:DataType="vm:AdminPatientsListViewModel"
             BackgroundColor="#F7F8FA">

    <VerticalStackLayout Padding="16,16,16,20" Spacing="16">

                <Grid RowDefinitions="Auto,5" RowSpacing="0">
            <Border Grid.Row="0" BackgroundColor="#176B38" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="12,10">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;"
                            FontSize="21" TextColor="#087A3D"
                            BackgroundColor="#F4C400" CornerRadius="9"
                            WidthRequest="38" HeightRequest="38" Padding="0"
                            Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="Patient Lookup"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="#F4C400" VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" />
        </Grid>
        <Frame x:Name="SearchFrame" BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="12" Padding="14,0" HeightRequest="48" HasShadow="False">
            <Entry x:Name="SearchEntry" Placeholder="Search by name or ID..." Text="{Binding SearchText}" VerticalOptions="Center"
                   Focused="SearchEntry_Focused" Unfocused="SearchEntry_Unfocused"/>
        </Frame>

        <Button Text="Register New Patient"
                IsVisible="{Binding CanRegisterPatients}"
                Command="{Binding RegisterPatientCommand}"
                BackgroundColor="#087A3D"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="46"/>
        <VerticalStackLayout IsVisible="{Binding HasSearched, Converter={StaticResource BoolInverter}}"
                              VerticalOptions="Center" Margin="0,60,0,0" Spacing="10">
            <Label Text="&#128269;" FontSize="40" HorizontalOptions="Center" TextColor="#C7CDD3"/>
            <Label Text="Start typing a name or ID to search" FontSize="15" FontAttributes="Bold" TextColor="#6B7684" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding HasSearched}"
                              VerticalOptions="Center" Margin="0,60,0,0" Spacing="10">
            <VerticalStackLayout.Triggers>
                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding HasPatients}" Value="True">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </VerticalStackLayout.Triggers>
            <Label Text="&#128101;" FontSize="40" HorizontalOptions="Center" TextColor="#C7CDD3"/>
            <Label Text="No patients found" FontSize="15" FontAttributes="Bold" TextColor="#6B7684" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Patients}" IsVisible="{Binding HasPatients}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PatientListItem">
                    <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14"
                           Padding="14" Margin="0,0,0,10" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenPatientCommand}" CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Frame Grid.Column="0" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                                   BackgroundColor="#E2E6EA" HasShadow="False" IsClippedToBounds="True">
                                <Grid>
                                    <Label Text="&#128100;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#9AA4AE"/>
                                    <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}" Aspect="AspectFill"/>
                                </Grid>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                                <Label FontSize="12" TextColor="#9AA4AE">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Role}"/>
                                            <Span Text=" · "/>
                                            <Span Text="{Binding IdNumber}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>