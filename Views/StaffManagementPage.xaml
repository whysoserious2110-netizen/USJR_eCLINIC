<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:models="clr-namespace:USJR_eCLINIC.Models"
             x:Class="USJR_eCLINIC.Views.StaffManagementPage"
             x:Name="Root"
             x:DataType="vm:StaffManagementViewModel"
             Title="Clinic Staff"
             BackgroundColor="#F7F8F6"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,5,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" BackgroundColor="#176B38" Padding="14,12" ColumnSpacing="12">
            <Button Text="‹" Command="{Binding GoBackCommand}" WidthRequest="42" HeightRequest="42"
                    CornerRadius="12" BackgroundColor="#F4C400" TextColor="#087A3D" FontSize="{StaticResource Typography.Headline}" Padding="0" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="Clinic Staff" FontSize="{StaticResource Typography.PageTitle}" FontAttributes="Bold" TextColor="#F4C400" />
                <Label Text="Accounts, roles, and schedules" FontSize="{StaticResource Typography.Body}" TextColor="White" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1" Color="#F4C400" />
        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding StaffMembers}" SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,16,16,8" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <SearchBar Placeholder="Search name, email, or employee ID"
                                       Text="{Binding SearchText}" FontSize="{StaticResource Typography.Body}" BackgroundColor="White" />
                            <Button Grid.Column="1" Text="+ Add" Command="{Binding AddStaffCommand}"
                                    BackgroundColor="#087A3D" TextColor="White" CornerRadius="10" />
                        </Grid>
                        <Picker Title="Filter by role" ItemsSource="{Binding RoleFilters}"
                                SelectedItem="{Binding SelectedRoleFilter}" BackgroundColor="White" />
                        <Label Text="{Binding ResultSummary}" FontSize="{StaticResource Typography.Body}" TextColor="#667085" />
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="6">
                        <Label Text="No clinic employees found" FontSize="{StaticResource Typography.Emphasis}" FontAttributes="Bold" TextColor="#344054" />
                        <Label Text="Add an employee account or adjust your search." FontSize="{StaticResource Typography.Body}" TextColor="#667085" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserAccount">
                        <Border Margin="14,5" Padding="14" BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding FullName}" FontSize="{StaticResource Typography.Emphasis}" FontAttributes="Bold" TextColor="#17212B" />
                                        <Label Text="{Binding Role}" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#087A3D" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AccountStatus}" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold"
                                           TextColor="#087A3D" VerticalOptions="Start" />
                                </Grid>
                                <Label Text="{Binding IdNumber, StringFormat='Employee ID: {0}'}" FontSize="{StaticResource Typography.Body}" TextColor="#344054" />
                                <Label Text="{Binding Email}" FontSize="{StaticResource Typography.Body}" TextColor="#667085" />
                                <Label Text="{Binding ProgramOrDepartment}" FontSize="{StaticResource Typography.Body}" TextColor="#667085" />
                                <Grid ColumnDefinitions="*">
                                    <Button Text="Edit" Command="{Binding Source={x:Reference Root}, Path=BindingContext.EditStaffCommand}"
                                            CommandParameter="{Binding .}" BackgroundColor="#F4C400" TextColor="#087A3D" CornerRadius="9" />
                                </Grid>
                                <Button Text="Activate" Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleActiveCommand}"
                                        CommandParameter="{Binding .}" BackgroundColor="#F2F4F7" TextColor="#344054" CornerRadius="9">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding AccountStatus}" Value="Active">
                                            <Setter Property="Text" Value="Deactivate" />
                                            <Setter Property="BackgroundColor" Value="#FDE8E7" />
                                            <Setter Property="TextColor" Value="#B42318" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
