<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.ConsultationPage"
             x:DataType="vm:ConsultationViewModel"
             BackgroundColor="#F7F8FA">

    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,30" Spacing="18">

            <Grid RowDefinitions="Auto,7" Margin="-20,-50,-20,0">
    <Border Grid.Row="0" BackgroundColor="#176B38" StrokeThickness="0"
            StrokeShape="Rectangle" Padding="18,50,18,14">
        <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="&#8592;" FontSize="{StaticResource Typography.PageTitle}"
                    TextColor="#087A3D" BackgroundColor="#F4C400"
                    CornerRadius="9" WidthRequest="40" HeightRequest="40"
                    Padding="0" Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="Medical Consultation" FontSize="{StaticResource Typography.Section}"
                   FontAttributes="Bold" TextColor="#F4C400"
                   VerticalOptions="Center" />
        </Grid>
    </Border>
    <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
</Grid>

            <Label Text="Review the recorded vital signs, document findings, then complete the visit. You may add a prescription for this same patient before saving." FontSize="{StaticResource Typography.Caption}" TextColor="#647067"/>

            <Frame BackgroundColor="#D5F5EF" CornerRadius="12" Padding="14" HasShadow="False">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding PatientName}" FontAttributes="Bold" FontSize="{StaticResource Typography.Emphasis}" TextColor="#12212E"/>
                    <Label Text="{Binding PatientRole}" FontSize="{StaticResource Typography.Caption}" TextColor="#0F9B8E"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
       BorderColor="#E2E6EA"
       CornerRadius="12"
       Padding="14"
       HasShadow="False">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Today's Vitals &amp; Nursing Assessment"
               FontAttributes="Bold"
               FontSize="{StaticResource Typography.Body}"
               TextColor="#12212E"/>

                    <Label Text="No vital signs have been recorded for this appointment."
               FontSize="{StaticResource Typography.Caption}"
               TextColor="#D9534F"
               IsVisible="{Binding HasVitals, Converter={StaticResource BoolInverter}}"/>

                    <VerticalStackLayout Spacing="12"
                             IsVisible="{Binding HasVitals}">

                        <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="12">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Blood Pressure"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#9AA4AE"/>

                                <Label Text="{Binding BloodPressure}"
                           FontSize="{StaticResource Typography.Body}"
                           FontAttributes="Bold"
                           TextColor="#12212E"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Temperature"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#9AA4AE"/>

                                <Label Text="{Binding Temperature}"
                           FontSize="{StaticResource Typography.Body}"
                           FontAttributes="Bold"
                           TextColor="#12212E"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Heart Rate"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#9AA4AE"/>

                                <Label Text="{Binding PulseRate}"
                           FontSize="{StaticResource Typography.Body}"
                           FontAttributes="Bold"
                           TextColor="#12212E"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Respiratory Rate"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#9AA4AE"/>

                                <Label Text="{Binding RespiratoryRate}"
                           FontSize="{StaticResource Typography.Body}"
                           FontAttributes="Bold"
                           TextColor="#12212E"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                                <Label Text="Oxygen Saturation"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#9AA4AE"/>

                                <Label Text="{Binding OxygenSaturation}"
                           FontSize="{StaticResource Typography.Body}"
                           FontAttributes="Bold"
                           TextColor="#12212E"/>
                            </VerticalStackLayout>

                        </Grid>

                        <BoxView HeightRequest="1"
                     BackgroundColor="#EEF1F3"/>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Initial Assessment"
                       FontSize="{StaticResource Typography.Caption}"
                       TextColor="#9AA4AE"/>

                            <Label Text="{Binding InitialAssessment}"
                       FontSize="{StaticResource Typography.Body}"
                       TextColor="#12212E"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Nursing Notes"
                       FontSize="{StaticResource Typography.Caption}"
                       TextColor="#9AA4AE"/>

                            <Label Text="{Binding NursingNotes}"
                       FontSize="{StaticResource Typography.Body}"
                       TextColor="#12212E"/>
                        </VerticalStackLayout>

                        <Label FontSize="{StaticResource Typography.Caption}"
                   TextColor="#9AA4AE">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Recorded by: "/>
                                    <Span Text="{Binding VitalsRecordedBy}"
                              FontAttributes="Bold"/>
                                    <Span Text=" · "/>
                                    <Span Text="{Binding VitalsRecordedAt}"/>
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Frame>

            <VerticalStackLayout Spacing="6">
                <Label Text="Chief Complaint" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E"/>
                <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="12" Padding="14,10" HasShadow="False">
                    <Editor Text="{Binding ChiefComplaint}" HeightRequest="60"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Diagnosis" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E"/>
                <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="12" Padding="14,10" HasShadow="False">
                    <Editor Placeholder="Enter diagnosis" Text="{Binding Diagnosis}" HeightRequest="60"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Treatment" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E"/>
                <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="12" Padding="14,10" HasShadow="False">
                    <Editor Placeholder="Enter treatment given" Text="{Binding Treatment}" HeightRequest="80"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Follow-Up Recommendation" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E"/>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="{Binding FollowUpRecommended}" />
                    <Label Text="Recommend a medical follow-up appointment"
                           FontSize="{StaticResource Typography.Caption}" TextColor="#526057" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <DatePicker Date="{Binding RecommendedFollowUpDate}"
                            IsVisible="{Binding FollowUpRecommended}" />
                <Label Text="Follow-Up Instructions (optional)" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#526057"/>
                <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="12" Padding="14,10" HasShadow="False">
                    <Editor Placeholder="Any follow-up instructions" Text="{Binding FollowUpNotes}" HeightRequest="60"/>
                </Frame>
            </VerticalStackLayout>

            <Button Text="Write Prescription for This Patient"
                    Command="{Binding OpenPrescriptionCommand}"
                    BackgroundColor="White" TextColor="#087A3D" BorderColor="#087A3D" BorderWidth="1"
                    FontAttributes="Bold" CornerRadius="12" HeightRequest="48"/>
            <Button Text="Save &amp; Complete Visit"
                    Command="{Binding SaveConsultationCommand}"
                    BackgroundColor="#087A3D"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="54"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
