<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.CertificatesPage"
             x:Name="Root"
             x:DataType="vm:CertificatesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <ContentPage.Resources>
        <conv:TabTextColorConverter x:Key="TabTextColor"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="{Binding HeaderTitle}" FontSize="17"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="14" RowSpacing="12">
            <Border Grid.Row="0" BackgroundColor="#F4C400" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" Padding="4">
                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" Padding="4,7"
                                         HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Action"/>
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding FirstTabLabel}" FontSize="12" FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{Binding IsPendingTab, Converter={StaticResource TabTextColor}}"/>
                        <BoxView HeightRequest="2" WidthRequest="76" IsVisible="{Binding IsPendingTab}" Color="#087A3D"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="4,7"
                                         HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="History"/>
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="History" FontSize="12" FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{Binding IsIssuedTab, Converter={StaticResource TabTextColor}}"/>
                        <BoxView HeightRequest="2" WidthRequest="44" IsVisible="{Binding IsIssuedTab}" Color="#087A3D"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Row="1"
                                 IsVisible="{Binding HasCertificates, Converter={StaticResource BoolInverter}}"
                                 VerticalOptions="Center" Spacing="9">
                <Label Text="&#128196;" FontSize="40" HorizontalOptions="Center" TextColor="#94A3B8"/>
                <Label Text="{Binding EmptyMessage}" FontSize="13" TextColor="#526057"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Certificates}"
                            IsVisible="{Binding HasCertificates}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CertificateListItem">
                        <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="13" Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCertificateCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding PatientName}" FontSize="14" FontAttributes="Bold"
                                           TextColor="#17221B" VerticalOptions="Center"/>
                                    <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="9,4">
                                        <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold"
                                               TextColor="White"/>
                                    </Border>
                                </Grid>
                                <Label Text="{Binding CertificateType}" FontSize="12" FontAttributes="Bold"
                                       TextColor="#087A3D"/>
                                <Label Text="{Binding Purpose}" FontSize="12" TextColor="#526057"
                                       LineBreakMode="TailTruncation" MaxLines="2"/>
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                                    <Label Text="{Binding DateDisplay}" FontSize="10" TextColor="#84918A"/>
                                    <Label Grid.Column="1" Text="·" FontSize="10" TextColor="#84918A"/>
                                    <Label Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="10" TextColor="#84918A"/>
                                </Grid>
                                <Label Text="{Binding ActionLabel, StringFormat='{0}  ›'}"
                                       FontSize="11" FontAttributes="Bold" TextColor="#087A3D"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
