<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.NurseProfilePage"
             x:DataType="vm:NurseProfileViewModel"
             BackgroundColor="#F7F8FA">

    <Grid RowDefinitions="Auto,6,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" BackgroundColor="#176B38" Padding="18,42,18,15">
            <Button Text="‹" Command="{Binding GoBackCommand}" FontSize="28"
                    TextColor="#087A3D" BackgroundColor="#F4C400" Padding="0"
                    HeightRequest="40" WidthRequest="40" CornerRadius="10" />
            <Label Grid.Column="1" Text="Nurse Profile" FontSize="20" FontAttributes="Bold"
                   TextColor="#F4C400" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Edit" Command="{Binding ToggleEditCommand}"
                    FontSize="13" FontAttributes="Bold" TextColor="#087A3D" BackgroundColor="#F4C400"
                    CornerRadius="9" Padding="13,7" VerticalOptions="Center" />
        </Grid>
        <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="6" />
        <ScrollView Grid.Row="2">
        <VerticalStackLayout Padding="16,16,16,30" Spacing="20">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Frame WidthRequest="80" HeightRequest="80" CornerRadius="40" Padding="0"
                       BackgroundColor="#E2E6EA" HasShadow="False" IsClippedToBounds="True">
                    <Grid>
                        <Label Text="&#128100;" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#9AA4AE"/>
                        <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}" Aspect="AspectFill"/>
                    </Grid>
                </Frame>
                <Label Text="Change photo" FontSize="12" Margin="60,0,60,0" FontAttributes="Bold" TextColor="#087A3D" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePhotoCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" TextColor="#12212E" HorizontalOptions="Center"/>
                <Frame BackgroundColor="#D5F5EF" Padding="10,3" CornerRadius="10" HasShadow="False">
                    <Label Text="NURSE" FontSize="11" Margin="70,0,60,0" FontAttributes="Bold" TextColor="#087A3D"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Personal Information -->
            <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Personal Information" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Full Name" FontSize="11" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding FullName}" IsEnabled="{Binding IsEditing}" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Employee ID" FontSize="11" TextColor="#9AA4AE"/>
                        <Label Text="{Binding IdNumber}" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" FontSize="11" TextColor="#9AA4AE"/>
                        <Label Text="{Binding Email}" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contact Number" FontSize="11" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding MobileNumber}" IsEnabled="{Binding IsEditing}" Placeholder="+63 9XX XXX XXXX" Keyboard="Telephone" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Professional Information -->
            <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Professional Information" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Position" FontSize="11" TextColor="#9AA4AE"/>
                        <Label Text="Nurse" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Department / Office" FontSize="11" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding Department}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., University Clinic" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="PRC License Number" FontSize="11" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding LicenseNumber}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., PRC-0987654" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="License Expiration" FontSize="11" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding LicenseExpiration}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., Dec 2028" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Specialization (optional)" FontSize="11" TextColor="#9AA4AE"/>
                        <Entry Text="{Binding Specialization}" IsEnabled="{Binding IsEditing}" Placeholder="e.g., School Health Nursing" FontSize="14" TextColor="#12212E"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Account Status" FontSize="11" TextColor="#9AA4AE"/>
                        <Frame BackgroundColor="#D5F5EF" Padding="10,4" CornerRadius="10" HasShadow="False" HorizontalOptions="Start">
                            <Label Text="{Binding EmploymentStatus}" FontSize="12" FontAttributes="Bold" TextColor="#087A3D"/>
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Changes"
                    Command="{Binding SaveCommand}"
                    IsVisible="{Binding IsEditing}"
                    BackgroundColor="#087A3D" TextColor="White" FontAttributes="Bold"
                    CornerRadius="26" HeightRequest="50" Margin="0,10,0,0"/>

            <Button Text="Log Out"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent" TextColor="#E05B5B" FontAttributes="Bold"
                    BorderColor="#E05B5B" BorderWidth="1" CornerRadius="26" HeightRequest="50" Margin="0,20,0,0"/>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>