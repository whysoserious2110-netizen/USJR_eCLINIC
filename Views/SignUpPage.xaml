<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.SignUpPage"
             x:DataType="vm:SignUpViewModel"
             Title="Create Account"
             BackgroundColor="#F7F8F6">
    <ContentPage.Resources>
        <conv:RoleSelectedConverter x:Key="RoleBgConverter"/>
        <conv:RoleSelectedTextColorConverter x:Key="RoleTextConverter"/>
        <conv:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="22,12,22,30" Spacing="0">
            <Grid RowDefinitions="Auto,5" Margin="-22,-12,-22,18">
                <Grid Grid.Row="0" ColumnDefinitions="48,*" BackgroundColor="#176B38" Padding="22,13">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="{StaticResource Typography.PageTitle}" TextColor="#087A3D"
                            BackgroundColor="#F4C400" CornerRadius="10" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Create Account" FontSize="{StaticResource Typography.Section}" FontAttributes="Bold"
                           TextColor="#F4C400" Margin="10,0,0,0" VerticalOptions="Center"/>
                </Grid>
                <BoxView Grid.Row="1" Color="#F4C400"/>
            </Grid>

            <Label Text="Choose your university role" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold"
                   TextColor="#17212B" Margin="0,0,0,8"/>
            <FlexLayout Wrap="Wrap" Margin="0,0,0,15">
                <Frame BackgroundColor="{Binding SelectedRole, Converter={StaticResource RoleBgConverter}, ConverterParameter='Student'}"
                       BorderColor="#DCE5DD" CornerRadius="18" Padding="15,8" Margin="0,0,8,8" HasShadow="False">
                    <Frame.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectRoleCommand}" CommandParameter="Student"/></Frame.GestureRecognizers>
                    <Label Text="Student" TextColor="{Binding SelectedRole, Converter={StaticResource RoleTextConverter}, ConverterParameter='Student'}"/>
                </Frame>
                <Frame BackgroundColor="{Binding SelectedRole, Converter={StaticResource RoleBgConverter}, ConverterParameter='Faculty'}"
                       BorderColor="#DCE5DD" CornerRadius="18" Padding="15,8" Margin="0,0,8,8" HasShadow="False">
                    <Frame.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectRoleCommand}" CommandParameter="Faculty"/></Frame.GestureRecognizers>
                    <Label Text="Faculty" TextColor="{Binding SelectedRole, Converter={StaticResource RoleTextConverter}, ConverterParameter='Faculty'}"/>
                </Frame>
                <Frame BackgroundColor="{Binding SelectedRole, Converter={StaticResource RoleBgConverter}, ConverterParameter='Non-Teaching'}"
                       BorderColor="#DCE5DD" CornerRadius="18" Padding="15,8" Margin="0,0,8,8" HasShadow="False">
                    <Frame.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectRoleCommand}" CommandParameter="Non-Teaching"/></Frame.GestureRecognizers>
                    <Label Text="Non-Teaching" TextColor="{Binding SelectedRole, Converter={StaticResource RoleTextConverter}, ConverterParameter='Non-Teaching'}"/>
                </Frame>
            </FlexLayout>

            <Label Text="{Binding IdLabel}" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E" Margin="0,0,0,7"/>
            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50" Margin="0,0,0,14">
                <Entry ClassId="NoAndroidUnderline" Text="{Binding IdNumber}" Placeholder="{Binding IdPlaceholder}" Keyboard="{Binding IdKeyboard}" MaxLength="{Binding IdMaxLength}" VerticalOptions="Center"/>
            </Border>
            <Label IsVisible="{Binding RequiresEmployeeIdReview}" Text="{Binding IdHelperText}" FontSize="{StaticResource Typography.Caption}" TextColor="#667085" Margin="0,-8,0,12"/>

            <VerticalStackLayout IsVisible="{Binding RequiresEmployeeIdReview}" Spacing="6" Margin="0,0,0,14">
                <Label Text="Employee ID photo (required for review)" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E"/>
                <Button Text="{Binding EmployeeIdPhotoButtonText}" Command="{Binding ChooseEmployeeIdImageCommand}"
                        BackgroundColor="White" TextColor="#087A3D" BorderColor="#087A3D" BorderWidth="1"
                        CornerRadius="11" HeightRequest="46"/>
                <Label Text="No photo selected" IsVisible="{Binding IsEmployeeIdPhotoMissing}" FontSize="{StaticResource Typography.Caption}" TextColor="#667085"/>
                <HorizontalStackLayout IsVisible="{Binding HasEmployeeIdPhoto}" Spacing="10">
                    <Image Source="{Binding FacultyIdImagePath}" WidthRequest="44" HeightRequest="44" Aspect="AspectFill"/>
                    <Label Text="{Binding EmployeeIdPhotoName}" FontSize="{StaticResource Typography.Caption}" TextColor="#667085" VerticalOptions="Center" LineBreakMode="MiddleTruncation"/>
                </HorizontalStackLayout>
                <Label Text="An authorized clinic administrator will compare this photo with an official university ID before activating the account."
                       FontSize="{StaticResource Typography.Caption}" TextColor="#667085"/>
            </VerticalStackLayout>

            <Label Text="{Binding ProgramDepartmentLabel}" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E" Margin="0,0,0,7"/>
            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="10,0" HeightRequest="52" Margin="0,0,0,14">
                <Picker Title="{Binding ProgramDepartmentPickerTitle}"
                        ItemsSource="{Binding ProgramDepartmentOptions}"
                        SelectedItem="{Binding SelectedProgramDepartment}"
                        TextColor="#17212B"/>
            </Border>

            <VerticalStackLayout IsVisible="{Binding IsStudent}" Spacing="6" Margin="0,-8,0,14">
                <Label Text="Year Level" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E"/>
                <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="10,0" HeightRequest="52">
                    <Picker Title="Select your current year level"
                            ItemsSource="{Binding YearLevelOptions}"
                            SelectedItem="{Binding SelectedYearLevel}"
                            TextColor="#17212B"/>
                </Border>
            </VerticalStackLayout>

            <Border IsVisible="{Binding IsOtherProgramDepartment}" BackgroundColor="White" Stroke="#DCE5DD"
                    StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50" Margin="0,-8,0,14">
                <Entry ClassId="NoAndroidUnderline" Text="{Binding OtherProgramDepartment}"
                       Placeholder="Enter your course, school, or department"/>
            </Border>

            <Label Text="Full Name" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E" Margin="0,0,0,7"/>
            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50" Margin="0,0,0,14">
                <Entry ClassId="NoAndroidUnderline" Text="{Binding FullName}" Placeholder="Last, First, M.I."/>
            </Border>

            <Label Text="USJ-R Email Address" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E" Margin="0,0,0,7"/>
            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50" Margin="0,0,0,14">
                <Entry ClassId="NoAndroidUnderline" Text="{Binding Email}" Placeholder="name@usjr.edu.ph" Keyboard="Email"/>
            </Border>

            <Label Text="Allergies (optional)" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E" Margin="0,0,0,7"/>
            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50" Margin="0,0,0,14">
                <Entry ClassId="NoAndroidUnderline" Text="{Binding Allergies}" Placeholder="Enter allergies (if any), or None"/>
            </Border>

            <Label Text="Password" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E" Margin="0,0,0,7"/>
            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50" Margin="0,0,0,14">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry ClassId="NoAndroidUnderline" Grid.Column="0" Text="{Binding Password}" Placeholder="Create a password" IsPassword="{Binding IsPasswordHidden}"/>
                    <Button Grid.Column="1" Text="{Binding PasswordVisibilityText}" Command="{Binding TogglePasswordVisibilityCommand}" BackgroundColor="Transparent" TextColor="#087A3D" Padding="6,0"/>
                </Grid>
            </Border>
            <Label Text="Confirm Password" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold" TextColor="#12212E" Margin="0,0,0,7"/>
            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="50" Margin="0,0,0,5">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry ClassId="NoAndroidUnderline" Grid.Column="0" Text="{Binding ConfirmPassword}" Placeholder="Re-enter your password" IsPassword="{Binding IsConfirmPasswordHidden}"/>
                    <Button Grid.Column="1" Text="{Binding ConfirmPasswordVisibilityText}" Command="{Binding ToggleConfirmPasswordVisibilityCommand}" BackgroundColor="Transparent" TextColor="#087A3D" Padding="6,0"/>
                </Grid>
            </Border>
            <Label Text="{Binding PasswordMatchMessage}" TextColor="{Binding PasswordMatchColor}" FontSize="{StaticResource Typography.Caption}" Margin="2,2,0,16"/>

            <HorizontalStackLayout Spacing="8" Margin="0,0,0,18">
                <CheckBox IsChecked="{Binding AgreedToPrivacyPolicy}" Color="#087A3D"/>
                <Label Text="I agree to the USJ-R Health Service Data Privacy Policy" FontSize="{StaticResource Typography.Body}" TextColor="#12212E" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Button Text="Continue to Email Verification" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsRegistering, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#087A3D" TextColor="White" FontAttributes="Bold" CornerRadius="18" HeightRequest="54"/>
            <ActivityIndicator IsVisible="{Binding IsRegistering}" IsRunning="{Binding IsRegistering}" Color="#087A3D" Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
