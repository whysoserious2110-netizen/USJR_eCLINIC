<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.ApeLabResultsPage"
             x:Name="Root"
             x:DataType="vm:ApeLabResultsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F8F6">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="APE LAB Result" FontSize="19"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid RowDefinitions="Auto,*" Padding="14,14,14,8" RowSpacing="10"
                  IsVisible="{Binding HasResults}">
                <VerticalStackLayout Grid.Row="0" Spacing="2">
                    <Label Text="Annual Physical Examination" FontSize="14"
                           FontAttributes="Bold" TextColor="#17221B" />
                    <Label Text="{Binding PatientName, StringFormat='Results for {0}'}"
                           FontSize="11" TextColor="#68756D" />
                </VerticalStackLayout>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Results}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApeLabResultItem">
                            <Border BackgroundColor="#2C9057" Stroke="#69A87A" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="13" Margin="0,0,0,9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenResultCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Border BackgroundColor="#D5F5EF" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6" Padding="7,3"
                                                HorizontalOptions="Start">
                                            <Label Text="{Binding Category}" FontSize="9" FontAttributes="Bold"
                                                   TextColor="#087A3D" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding DateDisplay, StringFormat='Issued: {0}'}"
                                               FontSize="10" TextColor="White" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="{Binding ResultTitle}" FontSize="12" FontAttributes="Bold"
                                           TextColor="White" />
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="RESULT SUMMARY" FontSize="8" TextColor="#D8E9DD" />
                                        <Label Text="{Binding ResultText}" FontSize="11" TextColor="White"
                                               LineBreakMode="TailTruncation" MaxLines="3" />
                                    </VerticalStackLayout>
                                    <BoxView HeightRequest="1" Color="#B7D6C0" Opacity="0.8" Margin="0,1,0,0" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="View full result" FontSize="10" FontAttributes="Bold"
                                               TextColor="White" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="&#8250;" FontSize="17"
                                               TextColor="#D5F5EF" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding HasNoResults}"
                                 VerticalOptions="Center" HorizontalOptions="Center"
                                 Spacing="9" Padding="24">
                <Label Text="&#128300;" FontSize="42" HorizontalOptions="Center" TextColor="#9AA4AE" />
                <Label Text="No APE results available" FontSize="15" FontAttributes="Bold"
                       TextColor="#526057" HorizontalOptions="Center" />
                <Label Text="Your Annual Physical Examination results will appear here after they are entered by the clinic."
                       FontSize="12" TextColor="#84918A" HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}"
                               Color="#087A3D" WidthRequest="36" HeightRequest="36"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" Color="#E7EBEF" HeightRequest="1" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,8,0,5">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#8962;" FontSize="20" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Appointments" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <Label Text="&#128276;" FontSize="18" TextColor="#087A3D" HorizontalOptions="Center" />
                    <Label Text="Notifications" FontSize="10" FontAttributes="Bold" TextColor="#087A3D" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
