<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.IssueCertificatePage"
             x:DataType="vm:IssueCertificateViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="Paper Certificate Review" FontSize="17"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border BackgroundColor="#FFF4C7" Stroke="#E8CF5A" StrokeThickness="1"
                        StrokeShape="RoundRectangle 15" Padding="15">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{Binding CertificateType}" FontSize="12"
                               FontAttributes="Bold" TextColor="#087A3D" />
                        <Label Text="{Binding PatientName}" FontSize="18"
                               FontAttributes="Bold" TextColor="#17221B" />
                        <Label Text="{Binding Purpose, StringFormat='Purpose: {0}'}"
                               FontSize="13" TextColor="#526057" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="CLINICAL REVIEW" FontSize="12" FontAttributes="Bold"
                               TextColor="#68756D" />
                        <Label Text="{Binding ClinicianRole, StringFormat='Reviewer role: {0}'}"
                               FontSize="12" TextColor="#526057" />
                        <Label Text="Review the patient’s visit and supporting records. If approved, prepare and sign the paper certificate before marking it ready for pickup. The app records its status; it does not create a digital certificate."
                               FontSize="13" TextColor="#17221B" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="7">
                    <Label Text="Decision note" FontSize="13" FontAttributes="Bold"
                           TextColor="#17221B" />
                    <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="12,8">
                        <Editor Placeholder="Required when declining; optional when approving"
                                Text="{Binding DecisionNote}" HeightRequest="95"
                                TextColor="#24342B" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Approve &amp; Mark Ready for Pickup"
                        Command="{Binding ApproveAndMarkReadyCommand}"
                        BackgroundColor="#087A3D" TextColor="White"
                        FontAttributes="Bold" CornerRadius="12" HeightRequest="50" />

                <Button Text="Decline Request"
                        Command="{Binding DeclineRequestCommand}"
                        BackgroundColor="#FDE8E7" TextColor="#B42318"
                        FontAttributes="Bold" CornerRadius="12" HeightRequest="48" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
