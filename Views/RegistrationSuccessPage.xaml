<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="USJR_eCLINIC.Views.RegistrationSuccessPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <ScrollView>
        <VerticalStackLayout Padding="22,28,22,30" Spacing="18">

            <Border BackgroundColor="#087A3D"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="22,26">
                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">
                    <Border WidthRequest="68"
                            HeightRequest="68"
                            BackgroundColor="#F4C400"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 34"
                            HorizontalOptions="Center">
                        <Label Text="&#x2713;"
                               FontSize="38"
                               FontAttributes="Bold"
                               TextColor="#087A3D"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <Label Text="Account Created Successfully!"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           LineBreakMode="WordWrap" />

                    <Label Text="Your account is ready. You can now sign in to your USJ-R e-Clinic account."
                           FontSize="14"
                           TextColor="#F2FFF7"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E9E4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="18,8">
                <Border.Shadow>
                    <Shadow Brush="#001A0D"
                            Opacity="0.08"
                            Radius="16"
                            Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="42,*"
                          Padding="0,12">
                        <Border WidthRequest="32" HeightRequest="32"
                                BackgroundColor="#FFF8D6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                VerticalOptions="Start">
                            <Label Text="&#x25CF;" FontSize="16" TextColor="#087A3D"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Full Name" FontSize="12" TextColor="#68756D" />
                            <Label x:Name="FullNameValue" FontSize="15" FontAttributes="Bold"
                                   TextColor="#17221B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E9EEE9" Margin="42,0,0,0" />

                    <Grid ColumnDefinitions="42,*" Padding="0,12">
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#FFF8D6"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Start">
                            <Label Text="#" FontSize="17" FontAttributes="Bold" TextColor="#087A3D"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label x:Name="IdLabel" FontSize="12" TextColor="#68756D" />
                            <Label x:Name="IdValue" FontSize="15" FontAttributes="Bold"
                                   TextColor="#17221B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E9EEE9" Margin="42,0,0,0" />

                    <Grid ColumnDefinitions="42,*" Padding="0,12">
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#FFF8D6"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Start">
                            <Label Text="&#x25C6;" FontSize="16" TextColor="#087A3D"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="University Role" FontSize="12" TextColor="#68756D" />
                            <Label x:Name="RoleValue" FontSize="15" FontAttributes="Bold"
                                   TextColor="#17221B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E9EEE9" Margin="42,0,0,0" />

                    <Grid ColumnDefinitions="42,*" Padding="0,12">
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#FFF8D6"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Start">
                            <Label Text="&#x25A6;" FontSize="16" TextColor="#087A3D"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Program / Department" FontSize="12" TextColor="#68756D" />
                            <Label x:Name="ProgramValue" FontSize="15" FontAttributes="Bold"
                                   TextColor="#17221B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E9EEE9" Margin="42,0,0,0" />

                    <Grid ColumnDefinitions="42,*" Padding="0,12">
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#FFF8D6"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Start">
                            <Label Text="@" FontSize="16" FontAttributes="Bold" TextColor="#087A3D"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Email Address" FontSize="12" TextColor="#68756D" />
                            <Label x:Name="EmailValue" FontSize="15" FontAttributes="Bold"
                                   TextColor="#17221B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E9EEE9" Margin="42,0,0,0" />

                    <Grid ColumnDefinitions="42,*" Padding="0,12">
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#FFF8D6"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Start">
                            <Label Text="&#x2713;" FontSize="17" FontAttributes="Bold" TextColor="#087A3D"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Account Status" FontSize="12" TextColor="#68756D" />
                            <Label x:Name="AccountStatusValue" FontSize="15" FontAttributes="Bold"
                                   TextColor="#17221B" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Continue to Sign In"
                    Clicked="OnContinueClicked"
                    BackgroundColor="#087A3D"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="54"
                    Margin="0,2,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
