<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.DoctorDashboardPage"
             x:Name="Root"
             x:DataType="vm:DoctorDashboardViewModel"
             BackgroundColor="#F7F8FA">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,50,20,20" Spacing="18">

                <!-- Greeting -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Frame Grid.Column="0"
                           WidthRequest="56" HeightRequest="56"
                           CornerRadius="28" Padding="0"
                           HasShadow="False"
                           BackgroundColor="#E2E6EA"
                           IsClippedToBounds="True">
                        <Label Text="&#128100;" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#9AA4AE"/>
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Adelante, Doc!" FontSize="13" TextColor="#6B7684"/>
                        <Label Text="{Binding DoctorName}" FontSize="19" FontAttributes="Bold" TextColor="#12212E"/>
                        <Frame BackgroundColor="#D5F5EF" Padding="10,3" CornerRadius="10"
                               HasShadow="False" HorizontalOptions="Start" Margin="0,4,0,0">
                            <Label Text="DOCTOR" FontSize="11" FontAttributes="Bold" TextColor="#0F9B8E"/>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>

                

                <!-- Doctor Quick Actions -->
                <Label Text="Doctor Quick Actions" FontSize="17" FontAttributes="Bold" TextColor="#12212E" Margin="0,6,0,0"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                    <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToTodaysVisitsCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#D5F5EF" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128197;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Today's Visits" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="{Binding TodayVisitsCount, StringFormat='{0} Appointments'}" FontSize="12" TextColor="#0F9B8E" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPatientRecordsCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#D5F5EF" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128193;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Patient Records" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Browse Archives" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToWriteRxCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#D5F5EF" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#8855;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Write Rx" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Create Prescription" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAnnouncementsCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#D5F5EF" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128227;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Announcements" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Post clinic notices" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Immediate Queue -->
                <VerticalStackLayout IsVisible="{Binding HasQueueItems}" Spacing="10" Margin="0,6,0,0">
                    <Label Text="Immediate Queue" FontSize="17" FontAttributes="Bold" TextColor="#12212E"/>

                    <CollectionView ItemsSource="{Binding ImmediateQueue}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueItem">
                                <Frame BackgroundColor="White" BorderColor="#0F9B8E" CornerRadius="14"
       Padding="16" Margin="0,0,0,12" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenConsultationCommand}" CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        
                                        <Frame Grid.Column="0" BackgroundColor="#D5F5EF" CornerRadius="10"
                                               Padding="6" WidthRequest="52" HeightRequest="52" HasShadow="False">
                                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding TimeDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#0F9B8E" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Frame>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding PatientName}" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                                            <Label Text="{Binding ChiefComplaint, StringFormat='C/O: {0}'}" FontSize="12" TextColor="#6B7684"/>
                                            <Label FontSize="11" TextColor="#9AA4AE">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="EMR Queue #"/>
                                                        <Span Text="{Binding QueueNumber}"/>
                                                        <Span Text=" · "/>
                                                        <Span Text="{Binding Location}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>


                <!-- Certificate Requests -->
                <VerticalStackLayout IsVisible="{Binding HasCertRequests}" Spacing="10" Margin="0,6,0,0">
                    <Label Text="Certificate Requests" FontSize="17" FontAttributes="Bold" TextColor="#12212E"/>

                    <CollectionView ItemsSource="{Binding PendingCertRequests}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CertRequestItem">
                                <Frame BackgroundColor="White" BorderColor="#D9A441" CornerRadius="14"
                       Padding="16" Margin="0,0,0,12" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenIssueCertificateCommand}" CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding PatientName}" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                                        <Label Text="{Binding CertificateType}" FontSize="12" TextColor="#0F9B8E"/>
                                        <Label Text="{Binding Purpose}" FontSize="12" TextColor="#6B7684"/>
                                        <Label Text="{Binding DateDisplay}" FontSize="11" TextColor="#9AA4AE"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>



            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom nav -->
        <Frame Grid.Row="1" BackgroundColor="White" CornerRadius="0" Padding="0,10" HasShadow="False">
            <Grid ColumnDefinitions="*,*,*,*">

                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="&#8962;" FontSize="18" TextColor="#0F9B8E" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="11" TextColor="#0F9B8E" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToPatientsCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128101;" FontSize="18" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                    <Label Text="Patients" FontSize="11" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                    <Label Text="Appointments" FontSize="11" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                    <Label Text="Profile" FontSize="11" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </Grid>
        </Frame>

    </Grid>
</ContentPage>