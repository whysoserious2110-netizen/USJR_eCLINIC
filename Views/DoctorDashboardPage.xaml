<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.DoctorDashboardPage"
             x:Name="Root"
             x:DataType="vm:DoctorDashboardViewModel"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,44,18,22" Spacing="16">

                <Grid RowDefinitions="Auto,7" Margin="-18,-44,-18,0">
    <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
            StrokeShape="Rectangle" Padding="18,44,18,13">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0"
                   HasShadow="False" BackgroundColor="#F4C400">
                <Label Text="&#128100;" FontSize="22" HorizontalOptions="Center"
                       VerticalOptions="Center" TextColor="#087A3D"/>
            </Frame>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Adelante, Doc!" FontSize="12" TextColor="White"/>
                <Label Text="{Binding DoctorName}" FontSize="18" FontAttributes="Bold" TextColor="#F4C400"/>
                <Label Text="DOCTOR" FontSize="10" FontAttributes="Bold" TextColor="White"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
    <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
</Grid>

                <Border IsVisible="{Binding HasAnnouncement}" BackgroundColor="#FFF4C7"
                        Stroke="#E8CF5A" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                    <Label Text="{Binding AnnouncementText}" FontSize="13" TextColor="#514A2C"/>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Patients Ready for Consultation" FontSize="18"
                               FontAttributes="Bold" TextColor="#17221B"/>
                        <Label 
                               FontSize="12" TextColor="#647067"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#E5F3EA" StrokeThickness="0"
                            StrokeShape="RoundRectangle 12" Padding="10,6" VerticalOptions="Start">
                        <Label Text="{Binding ReadyForConsultationCount}" FontSize="14"
                               FontAttributes="Bold" TextColor="#087A3D"/>
                    </Border>
                </Grid>

                <Border IsVisible="{Binding HasQueueItems, Converter={StaticResource BoolInverter}}"
                        BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="No patients checked in yet" FontSize="14"
                               FontAttributes="Bold" TextColor="#17221B"/>
                        <Label Text="Appointments become available here after R.E.A.D.S. confirms the patient’s arrival."
                               FontSize="12" TextColor="#647067"/>
                    </VerticalStackLayout>
                </Border>

                <CollectionView ItemsSource="{Binding ImmediateQueue}" IsVisible="{Binding HasQueueItems}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueItem">
                            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="10" RowSpacing="4">
                                    <Label Grid.Row="0" Text="{Binding VisitLabel}" FontSize="11"
                                           FontAttributes="Bold" TextColor="#087A3D"/>
                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#E5F3EA"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="8,3">
                                        <Label Text="{Binding VisitStatus}" FontSize="10"
                                               FontAttributes="Bold" TextColor="#087A3D"/>
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PatientName}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#17221B"/>
                                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding ChiefComplaint, StringFormat='Reason: {0}'}"
                                           FontSize="12" TextColor="#647067"/>
                                    <Label Grid.Row="3" Grid.ColumnSpan="2" FontSize="11" TextColor="#879188">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Queue #"/>
                                                <Span Text="{Binding QueueNumber}"/>
                                                <Span Text=" · "/>
                                                <Span Text="{Binding TimeDisplay}"/>
                                                <Span Text=" · "/>
                                                <Span Text="{Binding Location}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Button Grid.Row="4" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                            Text="Start Consultation"
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenConsultationCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#087A3D" TextColor="White"
                                            FontAttributes="Bold" CornerRadius="10" HeightRequest="44"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Doctor Work Areas" FontSize="17" FontAttributes="Bold"
                       TextColor="#17221B" Margin="0,4,0,0"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" Stroke="#DCE5DD"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="13">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToTodaysVisitsCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="&#128197;" FontSize="20" TextColor="#087A3D"/>
                            <Label Text="Today's Schedule" FontSize="13" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="{Binding TodayVisitsCount, StringFormat='{0} appointments'}"
                                   FontSize="11" TextColor="#647067"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" Stroke="#DCE5DD"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="13">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPatientRecordsCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="&#128193;" FontSize="20" TextColor="#087A3D"/>
                            <Label Text="Patient Records" FontSize="13" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="Consultation history" FontSize="11" TextColor="#647067"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" Stroke="#DCE5DD"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="13">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToWriteRxCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="&#128138;" FontSize="20" TextColor="#087A3D"/>
                            <Label Text="New Prescription" FontSize="13" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="Select a patient" FontSize="11" TextColor="#647067"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#E8CF5A"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="13">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCertificatesCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="&#128196;" FontSize="20" TextColor="#087A3D"/>
                            <Label Text="Paper Certificate Reviews" FontSize="13" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="{Binding CertificateReviewCount, StringFormat='{0} completed requests'}"
                                   FontSize="11" TextColor="#647067"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding HasCertRequests}" Spacing="9" Margin="0,2,0,0">
                    <Label Text="Completed Visits — Certificate Review" FontSize="17"
                           FontAttributes="Bold" TextColor="#17221B"/>
                    <Label Text="Review the completed visit and records. Prepare and sign the paper certificate before marking it ready; the app only tracks the request."
                           FontSize="12" TextColor="#647067"/>
                    <CollectionView ItemsSource="{Binding PendingCertRequests}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CertRequestItem">
                                <Border BackgroundColor="White" Stroke="#E8CF5A" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding CertificateType}" FontSize="11"
                                               FontAttributes="Bold" TextColor="#087A3D"/>
                                        <Label Text="{Binding PatientName}" FontSize="14"
                                               FontAttributes="Bold" TextColor="#17221B"/>
                                        <Label Text="{Binding Purpose, StringFormat='Purpose: {0}'}"
                                               FontSize="12" TextColor="#647067"/>
                                        <Label Text="{Binding DateDisplay}" FontSize="11" TextColor="#879188"/>
                                        <Button Text="Review Paper Request"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenIssueCertificateCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#087A3D" TextColor="White"
                                                FontAttributes="Bold" CornerRadius="10" HeightRequest="42"
                                                Margin="0,5,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" Stroke="#E5E9E5" StrokeThickness="0"
                Padding="0,9">
            <Grid ColumnDefinitions="*,*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="&#8962;" FontSize="18" TextColor="#087A3D" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="11" TextColor="#087A3D" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#879188" HorizontalOptions="Center"/>
                    <Label Text="Appointments" FontSize="11" TextColor="#879188" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128276;" FontSize="18" TextColor="#879188" HorizontalOptions="Center"/>
                    <Label Text="Notifications" FontSize="11" TextColor="#879188" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#879188" HorizontalOptions="Center"/>
                    <Label Text="Profile" FontSize="11" TextColor="#879188" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>