<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.MedicineInventoryPage"
             x:Name="Root"
             x:DataType="vm:MedicineInventoryViewModel"
             BackgroundColor="#F5F7F9">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,40,20,18" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Text="‹" Command="{Binding GoBackCommand}" FontSize="30"
                        TextColor="#078F83" BackgroundColor="Transparent" Padding="0"
                        HeightRequest="42" WidthRequest="36" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Medicine Inventory" FontSize="21" FontAttributes="Bold" TextColor="#172B3A" />
                    <Label Text="Track stock and restock levels" FontSize="12" TextColor="#72808D" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="+ Add medicine" Command="{Binding OpenAddNewCommand}"
                        FontSize="12" FontAttributes="Bold" TextColor="White" BackgroundColor="#078F83"
                        CornerRadius="12" Padding="12,8" VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" BackgroundColor="White" Stroke="#E1E7EC" StrokeThickness="1"
                    Padding="14" StrokeShape="RoundRectangle 15">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#E8F6F4"
                            StrokeThickness="0" StrokeShape="RoundRectangle 21">
                        <Label Text="&#128138;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding StockSummaryText}" FontSize="14" FontAttributes="Bold" TextColor="#172B3A" />
                        <Label Text="{Binding TotalItemCount, StringFormat='{0} medicine types in inventory'}"
                               FontSize="12" TextColor="#72808D" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="9">
                <Border Grid.Row="0" BackgroundColor="White" Stroke="#DDE4E9" StrokeThickness="1"
                        Padding="12,1" StrokeShape="RoundRectangle 12">
                    <Entry Placeholder="Search medicine name" Text="{Binding SearchText}"
                           ClearButtonVisibility="WhileEditing" TextColor="#172B3A" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border BackgroundColor="White" Stroke="#DDE4E9" StrokeThickness="1"
                            Padding="10,0" StrokeShape="RoundRectangle 12">
                        <Picker Title="Filter inventory" ItemsSource="{Binding FilterOptions}"
                                SelectedItem="{Binding SelectedFilter}" TextColor="#172B3A" />
                    </Border>
                    <Label Grid.Column="1" Text="{Binding ResultCountText}" FontSize="12"
                           TextColor="#72808D" VerticalOptions="Center" />
                </Grid>
            </Grid>

            <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,50,20,20" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Inventory is empty" FontSize="17" FontAttributes="Bold"
                               TextColor="#425466" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding EmptyMessage}" FontSize="12" TextColor="#72808D"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MedicineStockItem">
                        <Border BackgroundColor="White" Stroke="#E1E7EC" StrokeThickness="1"
                                Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 15">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding MedicineName}" FontSize="15" FontAttributes="Bold"
                                           TextColor="#172B3A" />
                                    <Label Text="{Binding ThresholdDisplay}" FontSize="11" TextColor="#72808D" />
                                </VerticalStackLayout>
                                <Border Grid.Row="0" Grid.Column="1"
                                        BackgroundColor="{Binding StockBadgeColor}"
                                        Padding="8,4" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding StockStateText}" FontSize="9" FontAttributes="Bold"
                                           TextColor="#FFFFFF" />
                                </Border>
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding QuantityDisplay}"
                                       FontSize="19" FontAttributes="Bold" TextColor="#078F83" VerticalOptions="Center" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Add stock"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenAddStockCommand}"
                                        CommandParameter="{Binding .}" BackgroundColor="#E8F6F4"
                                        TextColor="#078F83" FontSize="12" FontAttributes="Bold"
                                        CornerRadius="11" HeightRequest="38" Padding="12,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid IsVisible="{Binding IsAddingStock}" BackgroundColor="#660E1B24">
            <Border BackgroundColor="White" Stroke="#E1E7EC" StrokeThickness="1" Padding="20"
                    Margin="28" VerticalOptions="Center" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="13">
                    <Label Text="Restock medicine" FontSize="18" FontAttributes="Bold" TextColor="#172B3A" />
                    <Label Text="{Binding SelectedItem.MedicineName}" FontSize="14" TextColor="#078F83" />
                    <Label Text="{Binding SelectedItem.Quantity, StringFormat='Current quantity: {0}'}"
                           FontSize="12" TextColor="#72808D" />
                    <Border BackgroundColor="#F5F7F9" Stroke="#DDE4E9" StrokeThickness="1"
                            Padding="12,1" StrokeShape="RoundRectangle 12">
                        <Entry Placeholder="Quantity to add" Text="{Binding AmountToAdd}"
                               Keyboard="Numeric" TextColor="#172B3A" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Cancel" Command="{Binding CancelAddStockCommand}"
                                BackgroundColor="#EEF1F3" TextColor="#425466" CornerRadius="12" />
                        <Button Grid.Column="1" Text="Add stock" Command="{Binding ConfirmAddStockCommand}"
                                BackgroundColor="#078F83" TextColor="White" FontAttributes="Bold" CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsAddingNew}" BackgroundColor="#660E1B24">
            <Border BackgroundColor="White" Stroke="#E1E7EC" StrokeThickness="1" Padding="20"
                    Margin="28" VerticalOptions="Center" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="11">
                    <Label Text="Add medicine" FontSize="18" FontAttributes="Bold" TextColor="#172B3A" />
                    <Border BackgroundColor="#F5F7F9" Stroke="#DDE4E9" StrokeThickness="1" Padding="12,1" StrokeShape="RoundRectangle 12">
                        <Entry Placeholder="Medicine name" Text="{Binding NewMedicineName}" TextColor="#172B3A" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                        <Border BackgroundColor="#F5F7F9" Stroke="#DDE4E9" StrokeThickness="1" Padding="12,1" StrokeShape="RoundRectangle 12">
                            <Entry Placeholder="Starting quantity" Text="{Binding NewQuantity}" Keyboard="Numeric" TextColor="#172B3A" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#F5F7F9" Stroke="#DDE4E9" StrokeThickness="1" Padding="12,1" StrokeShape="RoundRectangle 12">
                            <Entry Placeholder="Unit (tablets, pcs)" Text="{Binding NewUnit}" TextColor="#172B3A" />
                        </Border>
                    </Grid>
                    <Border BackgroundColor="#F5F7F9" Stroke="#DDE4E9" StrokeThickness="1" Padding="12,1" StrokeShape="RoundRectangle 12">
                        <Entry Placeholder="Restock alert threshold" Text="{Binding NewLowStockThreshold}"
                               Keyboard="Numeric" TextColor="#172B3A" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,3,0,0">
                        <Button Text="Cancel" Command="{Binding CancelAddNewCommand}"
                                BackgroundColor="#EEF1F3" TextColor="#425466" CornerRadius="12" />
                        <Button Grid.Column="1" Text="Save medicine" Command="{Binding ConfirmAddNewCommand}"
                                BackgroundColor="#078F83" TextColor="White" FontAttributes="Bold" CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
