<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="USJR_eCLINIC.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="#F7F8FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,70,30,30"
            Spacing="0">

            <!-- Header -->
            <Label
                Text="Welcome Back"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#12212E"/>

            <Label
                Text="Log in to manage your medical records online"
                FontSize="14"
                TextColor="#6B7684"
                Margin="0,6,0,30"/>

            <!-- Email or ID -->
            <Label
                Text="Email or Student/Employee ID"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="#12212E"
                Margin="0,50,0,8"/>

            <Frame
                BackgroundColor="White"
                BorderColor="#E2E6EA"
                CornerRadius="12"
                Padding="14,0"
                HeightRequest="52"
                HasShadow="False"
                Margin="0,0,0,20">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Text="&#9993;"
                        FontSize="18"
                        TextColor="#9AA4AE"
                        VerticalOptions="Center"/>

                    <Entry
                        Grid.Column="1"
                        Text="{Binding EmailOrId}"
                        Placeholder="e.g., student-id@usjr.edu.ph"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        ReturnType="Next"/>
                </Grid>
            </Frame>

            <!-- Password -->
            <Label
                Text="Password"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="#12212E"
                Margin="0,0,0,8"/>

            <Frame
                BackgroundColor="White"
                BorderColor="#E2E6EA"
                CornerRadius="12"
                Padding="14,0"
                HeightRequest="52"
                HasShadow="False"
                Margin="0,0,0,10">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Text="&#128274;"
                        FontSize="16"
                        TextColor="#9AA4AE"
                        VerticalOptions="Center"/>

                    <Entry
                        Grid.Column="1"
                        Text="{Binding Password}"
                        Placeholder="Enter your password"
                        IsPassword="{Binding IsPasswordHidden}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        ReturnType="Done"
                        ReturnCommand="{Binding LogInCommand}"/>

                    <Label
                        Grid.Column="2"
                        Text="{Binding ShowHideText}"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#0F9B8E"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding TogglePasswordVisibilityCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Frame>

            <!-- Remember me and Forgot Password -->
            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,24">

                <HorizontalStackLayout
                    Grid.Column="0"
                    Spacing="8"
                    VerticalOptions="Center">

                    <CheckBox
                        IsChecked="{Binding RememberMe}"
                        Color="#0F9B8E"
                        HeightRequest="22"
                        WidthRequest="22"/>

                    <Label
                        Text="Remember me"
                        FontSize="14"
                        TextColor="#12212E"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label
                    Grid.Column="1"
                    Text="Forgot Password?"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#0F9B8E"
                    VerticalOptions="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding ForgotPasswordCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Log In -->
            <Button
                Text="Log In"
                Command="{Binding LogInCommand}"
                IsEnabled="{Binding IsLoggingIn,
                    Converter={StaticResource BoolInverter}}"
                BackgroundColor="#0F9B8E"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="26"
                HeightRequest="54"/>

            <!-- Sign Up -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Margin="0,24,0,0"
                Spacing="4">

                <Label
                    Text="Don't have an account?"
                    FontSize="14"
                    TextColor="#12212E"/>

                <Label
                    Text="Sign Up"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#0F9B8E">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SignUpCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>