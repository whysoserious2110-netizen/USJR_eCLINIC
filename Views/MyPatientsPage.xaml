<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.MyPatientsPage"
             x:Name="Root"
             x:DataType="vm:MyPatientsViewModel"
             BackgroundColor="#F7F8FA">

    <VerticalStackLayout Padding="20,50,20,20" Spacing="16">

        <Grid RowDefinitions="Auto,7" Margin="-20,-50,-20,0">
    <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
            StrokeShape="Rectangle" Padding="18,50,18,14">
        <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                    TextColor="#087A3D" BackgroundColor="#F4C400"
                    CornerRadius="9" WidthRequest="40" HeightRequest="40"
                    Padding="0" Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="Patient Records" FontSize="18"
                   FontAttributes="Bold" TextColor="#F4C400"
                   VerticalOptions="Center" />
        </Grid>
    </Border>
    <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
</Grid>

        <Label Text="Patients you have personally consulted." FontSize="12" TextColor="#9AA4AE" FontAttributes="Italic"/>

        <VerticalStackLayout IsVisible="{Binding HasPatients, Converter={StaticResource BoolInverter}}"
                              VerticalOptions="Center" Margin="0,60,0,0" Spacing="10">
            <Label Text="&#128203;" FontSize="40" HorizontalOptions="Center" TextColor="#C7CDD3"/>
            <Label Text="No patient records yet" FontSize="15" FontAttributes="Bold" TextColor="#6B7684" HorizontalOptions="Center"/>
            <Label Text="Patients you consult will appear here." FontSize="12" TextColor="#9AA4AE" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Patients}" IsVisible="{Binding HasPatients}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MyPatientItem">
                    <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14"
                           Padding="14" Margin="0,0,0,10" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenPatientCommand}" CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Frame Grid.Column="0" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                                   BackgroundColor="#E2E6EA" HasShadow="False" IsClippedToBounds="True">
                                <Grid>
                                    <Label Text="&#128100;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#9AA4AE"/>
                                    <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}" Aspect="AspectFill"/>
                                </Grid>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                                <Label FontSize="12" TextColor="#9AA4AE">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Role}"/>
                                            <Span Text=" · "/>
                                            <Span Text="{Binding IdNumber}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding LastVisitDisplay}" FontSize="11" TextColor="#0F9B8E"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>