<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.AppointmentsPage"
             x:Name="Root"

             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F8F6">
        <!-- USJ-R green header with yellow title and accent stripe. -->
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="10" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}"
                            VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding HeaderTitle}"
                           FontSize="19" FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <Grid Grid.Row="1">
            <!-- Appointment list and filters -->
            <Grid IsVisible="{Binding IsDetailVisible, Converter={StaticResource BoolInverter}}"
                  RowDefinitions="Auto,*" Padding="14,14,14,8" RowSpacing="12">
                <Border Grid.Row="0" BackgroundColor="#F4C400" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="4">
                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" Padding="4,7"
                                             HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="All" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="All" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{Binding IsAllTab, Converter={StaticResource TabTextColor}}" />
                            <BoxView HeightRequest="2" WidthRequest="30" IsVisible="{Binding IsAllTab}" Color="#087A3D" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="4,7"
                                             HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Upcoming" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Upcoming" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{Binding IsUpcomingTab, Converter={StaticResource TabTextColor}}" />
                            <BoxView HeightRequest="2" WidthRequest="60" IsVisible="{Binding IsUpcomingTab}" Color="#087A3D" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4" Padding="4,7"
                                             HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Past" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Past" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{Binding IsPastTab, Converter={StaticResource TabTextColor}}" />
                            <BoxView HeightRequest="2" WidthRequest="30" IsVisible="{Binding IsPastTab}" Color="#087A3D" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Grid.Row="1"
                                     IsVisible="{Binding HasAppointments, Converter={StaticResource BoolInverter}}"
                                     VerticalOptions="Center" Spacing="9">
                    <Label Text="&#128197;" FontSize="38" HorizontalOptions="Center" TextColor="#9AA4AE" />
                    <Label Text="No appointments here" FontSize="15" FontAttributes="Bold"
                           TextColor="#526057" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Appointments}"
                                IsVisible="{Binding HasAppointments}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppointmentListItem">
                            <Border BackgroundColor="White" Stroke="#DCE5DD"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 14"
                                    Padding="14" Margin="0,0,0,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenAppointmentCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding DetailTitle}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#17221B" />
                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{Binding StatusColor}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,4">
                                        <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ServiceType}" FontSize="12" TextColor="#526057"
                                           Margin="0,5,0,0" />
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                          ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5" Margin="0,5,0,0">
                                        <Label Grid.Column="0" Text="{Binding DateDisplay}" FontSize="11" TextColor="#84918A" />
                                        <Label Grid.Column="1" Text="·" FontSize="11" TextColor="#84918A" />
                                        <Label Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="11" TextColor="#84918A" />
                                    </Grid>
                                    <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="View appointment details  &#8250;" FontSize="11"
                                           FontAttributes="Bold" TextColor="#087A3D" Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Hierarchical detail view for the appointment the student taps. -->
            <ScrollView IsVisible="{Binding IsDetailVisible}">
                <VerticalStackLayout Padding="16,16,16,22" Spacing="14">
                    <Border BackgroundColor="#FFF4C7" Stroke="#E8CF5A" StrokeThickness="1"
                            StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding SelectedAppointment.ServiceType}"
                                   FontSize="12" FontAttributes="Bold" TextColor="#087A3D" />
                            <Label Text="{Binding SelectedAppointment.DetailTitle}"
                                   FontSize="20" FontAttributes="Bold" TextColor="#17221B" />
                            <Border BackgroundColor="{Binding SelectedAppointment.StatusColor}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    Padding="10,5" HorizontalOptions="Start">
                                <Label Text="{Binding SelectedAppointment.Status}"
                                       FontSize="11" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="APPOINTMENT DETAILS" FontSize="12" FontAttributes="Bold"
                               TextColor="#68756D" />
                        <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="82,*" Padding="0,5">
                                    <Label Text="DATE" FontSize="10" FontAttributes="Bold" TextColor="#84918A" />
                                    <Label Grid.Column="1" Text="{Binding SelectedAppointment.DateDisplay}"
                                           FontSize="13" TextColor="#17221B" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#EEF1ED" />
                                <Grid ColumnDefinitions="82,*" Padding="0,10,0,5">
                                    <Label Text="TIME" FontSize="10" FontAttributes="Bold" TextColor="#84918A" />
                                    <Label Grid.Column="1" Text="{Binding SelectedAppointment.TimeDisplay}"
                                           FontSize="13" TextColor="#17221B" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#EEF1ED" />
                                <Grid ColumnDefinitions="82,*" Padding="0,10,0,5">
                                    <Label Text="LOCATION" FontSize="10" FontAttributes="Bold" TextColor="#84918A" />
                                    <Label Grid.Column="1" Text="{Binding SelectedAppointment.Location}"
                                           FontSize="13" TextColor="#17221B" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#EEF1ED" />
                                <Grid ColumnDefinitions="82,*" Padding="0,10,0,5">
                                    <Label Text="SERVICE" FontSize="10" FontAttributes="Bold" TextColor="#84918A" />
                                    <Label Grid.Column="1" Text="{Binding SelectedAppointment.ServiceType}"
                                           FontSize="13" TextColor="#17221B" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding SelectedAppointment.IsCertificateRequest}" Spacing="8">
                        <Label Text="PAPER CERTIFICATE TRACKING" FontSize="12" FontAttributes="Bold"
                               TextColor="#68756D" />
                        <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Certificate status" FontSize="12" TextColor="#68756D"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1" BackgroundColor="#FFF4C7" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9" Padding="9,4">
                                        <Label Text="{Binding SelectedAppointment.CertificateStatus}"
                                               FontSize="10" FontAttributes="Bold" TextColor="#087A3D" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding SelectedAppointment.CertificateTrackingMessage}"
                                       FontSize="12" TextColor="#17221B" />
                                <Label Text="{Binding SelectedAppointment.CertificateDecisionNote, StringFormat='Clinician note: {0}'}"
                                       IsVisible="{Binding SelectedAppointment.HasCertificateDecisionNote}"
                                       FontSize="11" TextColor="#68756D" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding SelectedAppointment.HasElapsedNotice}"
                            BackgroundColor="#FFF0E8" Stroke="#F5C3A8" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="13">
                        <Label Text="{Binding SelectedAppointment.ElapsedNotice}"
                               FontSize="12" TextColor="#8A3B12" />
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding SelectedAppointment.HasReasonOrPurpose}" Spacing="8">
                        <Label Text="REASON / ADDITIONAL DETAILS" FontSize="12" FontAttributes="Bold"
                               TextColor="#68756D" />
                        <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14">
                            <Label Text="{Binding SelectedAppointment.ReasonOrPurpose}"
                                   FontSize="13" TextColor="#17221B" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Cancel Appointment"
                            IsVisible="{Binding SelectedAppointment.CanCancel}"
                            Command="{Binding CancelAppointmentCommand}"
                            CommandParameter="{Binding SelectedAppointment}"
                            BackgroundColor="#FDE8E7" TextColor="#B42318"
                            FontSize="14" FontAttributes="Bold"
                            CornerRadius="12" HeightRequest="48" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Student navigation; appointment is the active section. -->
        <Grid Grid.Row="2" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" Color="#E7EBEF" HeightRequest="1" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,8,0,5">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#8962;" FontSize="20" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <Label Text="&#128197;" FontSize="18" TextColor="#087A3D" HorizontalOptions="Center" />
                    <Label Text="Appointments" FontSize="10" FontAttributes="Bold" TextColor="#087A3D" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128276;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Notifications" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>






