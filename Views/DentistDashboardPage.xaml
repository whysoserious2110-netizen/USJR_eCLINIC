<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.DentistDashboardPage"
             x:Name="Root"
             x:DataType="vm:DentistDashboardViewModel"
             BackgroundColor="#F7F8FA">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,0,16,16" Spacing="12">

                <!-- Yellow Dentist identity header from the reference -->
                <Border BackgroundColor="#F4C400" StrokeThickness="0"
                        StrokeShape="RoundRectangle 0" Padding="16,42,16,12"
                        Margin="-16,0,-16,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border WidthRequest="42" HeightRequest="42" BackgroundColor="White"
                                Stroke="#2C9057" StrokeThickness="2"
                                StrokeShape="RoundRectangle 22" Padding="1">
                            <Grid>
                                <Label Text="&#128100;" FontSize="20" TextColor="#91A0AC"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}"
                                       Aspect="AspectFill"/>
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Adelante, Josesian Dentist!" FontSize="13" TextColor="#087A3D"/>
                            <Label Text="{Binding DentistName}" FontSize="20" FontAttributes="Bold"
                                   TextColor="#087A3D" LineBreakMode="TailTruncation"/>
                            <Border BackgroundColor="#FDE6EC" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 7" Padding="6,2"
                                    HorizontalOptions="Start">
                                <Label Text="DENTIST" FontSize="11" FontAttributes="Bold" TextColor="#D94B68"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Shows the active Reads announcement, never a hard-coded sample notice -->
                <Border BackgroundColor="#FFF3CD" Stroke="#F4C400" StrokeThickness="0.5"
                        StrokeShape="RoundRectangle 10" Padding="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#9432;" FontSize="15" TextColor="#A66B00" VerticalOptions="Start"/>
                        <Label Grid.Column="1" Text="{Binding AnnouncementText}" FontSize="14"
                               TextColor="#66551F" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Compact, clickable gateway to the full clinic summary and visit stages -->
                <Border BackgroundColor="White" Stroke="#EF6B82" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="11,10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToClinicSummaryCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Today's Dental Clinic Summary" FontSize="18"
                               FontAttributes="Bold" TextColor="#17221B" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="&#8250;" FontSize="22" FontAttributes="Bold"
                               TextColor="#E94F70" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Label Text="Dental Quick Actions" FontSize="19" FontAttributes="Bold"
                       TextColor="#17221B" Margin="0,2,0,0"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" Stroke="#E6EAF0"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="9">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedQuickAction}" Value="Today">
                                <Setter Property="BackgroundColor" Value="#FFF3CD"/>
                                <Setter Property="Stroke" Value="#F4C400"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToTodaysVisitsCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Border WidthRequest="27" HeightRequest="27" BackgroundColor="#FDE8ED"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                <Label Text="&#128197;" FontSize="18" TextColor="#E94F70"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Today's Visit" FontSize="15" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="{Binding ActiveVisitCount, StringFormat='{0} Active Visits'}"
                                   FontSize="12" TextColor="#D94B68"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" Stroke="#E6EAF0"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="9">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedQuickAction}" Value="FollowUps">
                                <Setter Property="BackgroundColor" Value="#FFF3CD"/>
                                <Setter Property="Stroke" Value="#F4C400"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToFollowUpPatientsCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Border WidthRequest="27" HeightRequest="27" BackgroundColor="#FDE8ED"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                <Label Text="&#128276;" FontSize="18" TextColor="#E94F70"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Follow Up Patients" FontSize="15" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="{Binding FollowUpVisitCount, StringFormat='{0} Upcoming Visits'}"
                                   FontSize="12" TextColor="#91A0AC"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" Stroke="#E6EAF0"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="9">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedQuickAction}" Value="Patients">
                                <Setter Property="BackgroundColor" Value="#FFF3CD"/>
                                <Setter Property="Stroke" Value="#F4C400"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPatientsCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Border WidthRequest="27" HeightRequest="27" BackgroundColor="#FDE8ED"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                <Label Text="&#128269;" FontSize="18" TextColor="#E94F70"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Patient Search" FontSize="15" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="Dental appointment patients" FontSize="12" TextColor="#91A0AC"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#E6EAF0"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="9">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedQuickAction}" Value="Certificates">
                                <Setter Property="BackgroundColor" Value="#FFF3CD"/>
                                <Setter Property="Stroke" Value="#F4C400"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCertificatesCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Border WidthRequest="27" HeightRequest="27" BackgroundColor="#FDE8ED"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                <Label Text="&#128196;" FontSize="18" TextColor="#E94F70"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Certificate Review" FontSize="15" FontAttributes="Bold" TextColor="#17221B"/>
                            <Label Text="Review Dental Requests" FontSize="12" TextColor="#91A0AC"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <Label Text="Ready for Dental Examination" FontSize="18" FontAttributes="Bold"
                           TextColor="#17221B" VerticalOptions="Center"/>
                    <Border Grid.Column="1" BackgroundColor="#FDE8ED" StrokeThickness="0"
                            StrokeShape="RoundRectangle 8" Padding="7,2">
                        <Label Text="{Binding ReadyForDentistCount}" FontSize="14"
                               FontAttributes="Bold" TextColor="#D94B68"/>
                    </Border>
                </Grid>

                <Border IsVisible="{Binding HasQueueItems, Converter={StaticResource BoolInverter}}"
                        BackgroundColor="White" Stroke="#E6EAF0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="11">
                    <Label Text="{Binding ReadyQueueEmptyMessage}" FontSize="14" TextColor="#647067"/>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DentalQueue}" Spacing="7">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DentalQueueItem">
                            <Border BackgroundColor="White" Stroke="#EF6B82" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenExaminationCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="8" RowSpacing="2">
                                    <Border Grid.RowSpan="3" WidthRequest="42" HeightRequest="42"
                                            BackgroundColor="#FDE8ED" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10">
                                        <Label Text="{Binding TimeDisplay}" FontSize="12" FontAttributes="Bold"
                                               TextColor="#D94B68" HorizontalOptions="Center"
                                               VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding PatientDisplayName}" FontSize="15"
                                           FontAttributes="Bold" TextColor="#17221B"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="2" Text="&#8250;" FontSize="18" FontAttributes="Bold"
                                           TextColor="#E94F70" VerticalOptions="Center"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding ReasonDisplay}" FontSize="13" TextColor="#647067" MaxLines="1"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding LocationDisplay}" FontSize="13" TextColor="#91A0AC" MaxLines="1"
                                           LineBreakMode="TailTruncation"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Plain white bottom navigation, as shown in the design -->
        <Border Grid.Row="1" BackgroundColor="White" Stroke="#E3E9EF" StrokeThickness="1"
                Padding="4,7" StrokeShape="RoundRectangle 0">
            <Grid ColumnDefinitions="*,*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="&#8962;" FontSize="18" TextColor="#00A99A" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="11" TextColor="#00A99A" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="17" TextColor="#91A0AC" HorizontalOptions="Center"/>
                    <Label Text="Appointments" FontSize="11" TextColor="#91A0AC" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128276;" FontSize="17" TextColor="#91A0AC" HorizontalOptions="Center"/>
                    <Label Text="Notifications" FontSize="11" TextColor="#91A0AC" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="17" TextColor="#91A0AC" HorizontalOptions="Center"/>
                    <Label Text="Profile" FontSize="11" TextColor="#91A0AC" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>


