<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="USJR_eCLINIC.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:USJR_eCLINIC.ViewModels"
    x:DataType="viewModels:ForgotPasswordViewModel"
    BackgroundColor="#F7F9FC"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,40"
            Spacing="20">

            <Button
                Text="← Back"
                Command="{Binding GoBackCommand}"
                HorizontalOptions="Start"
                BackgroundColor="Transparent"
                TextColor="#4B5563"
                FontSize="15"
                Padding="0,8"/>

            <VerticalStackLayout
                Spacing="6">

                <Label
                    Text="Reset your password"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#17212B"/>

                <Label
                    Text="Recover your account securely."
                    FontSize="14"
                    TextColor="#7B8794"/>
            </VerticalStackLayout>

            <!-- Progress indicator -->
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8">

                <BoxView
                    Grid.Column="0"
                    HeightRequest="4"
                    CornerRadius="2"
                    Color="#00A99D"/>

                <BoxView
                    Grid.Column="1"
                    HeightRequest="4"
                    CornerRadius="2"
                    Color="#D8DEE6"/>

                <BoxView
                    Grid.Column="2"
                    HeightRequest="4"
                    CornerRadius="2"
                    Color="#D8DEE6"/>
            </Grid>

            <!-- Step 1: Student ID -->
            <Border
                IsVisible="{Binding IsStudentIdStep}"
                Padding="20"
                BackgroundColor="White"
                Stroke="#E1E6EC"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Find your account"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#17212B"/>

                    <Label
                        Text="Enter the ID number connected to your e-Clinic account."
                        FontSize="14"
                        TextColor="#667085"/>

                    <Label
                        Text="ID Number"
                        FontAttributes="Bold"
                        TextColor="#344054"/>

                    <Entry
                        Text="{Binding StudentId}"
                        Placeholder="Example: S-1003"
                        Keyboard="Text"
                        ReturnType="Done"/>

                    <Button
                        Text="Continue"
                        Command="{Binding SendCodeCommand}"
                        BackgroundColor="#00A99D"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="52"/>
                </VerticalStackLayout>
            </Border>

            <!-- Step 2: Verification code -->
            <Border
                IsVisible="{Binding IsVerificationStep}"
                Padding="20"
                BackgroundColor="White"
                Stroke="#E1E6EC"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Enter verification code"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#17212B"/>

                    <Label
                        Text="{Binding RecoveryText}"
                        FontSize="14"
                        TextColor="#667085"/>

                    <Border
                        IsVisible="{Binding HasDemoCode}"
                        Padding="14"
                        BackgroundColor="#FFF8E1"
                        Stroke="#F4C95D"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="DEMO VERIFICATION CODE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#8A6500"/>

                            <Label
                                Text="{Binding DemoCode}"
                                FontSize="25"
                                FontAttributes="Bold"
                                CharacterSpacing="4"
                                TextColor="#6B5000"/>
                        </VerticalStackLayout>
                    </Border>

                    <Entry
                        Text="{Binding VerificationCode}"
                        Placeholder="6-digit code"
                        Keyboard="Numeric"
                        MaxLength="6"
                        HorizontalTextAlignment="Center"
                        FontSize="22"/>

                    <Button
                        Text="Verify code"
                        Command="{Binding VerifyCodeCommand}"
                        BackgroundColor="#00A99D"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="52"/>

                    <Button
                        Text="Resend code"
                        Command="{Binding ResendCodeCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#00A99D"/>
                </VerticalStackLayout>
            </Border>

            <!-- Step 3: New password -->
            <Border
                IsVisible="{Binding IsNewPasswordStep}"
                Padding="20"
                BackgroundColor="White"
                Stroke="#E1E6EC"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Create new password"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#17212B"/>

                    <Label
                        Text="Use at least 8 characters with uppercase, lowercase, number, and special character."
                        FontSize="14"
                        TextColor="#667085"/>

                    <Label
                        Text="New password"
                        FontAttributes="Bold"
                        TextColor="#344054"/>

                    <Entry
                        Text="{Binding NewPassword}"
                        Placeholder="Enter new password"
                        IsPassword="True"/>

                    <Label
                        Text="Confirm password"
                        FontAttributes="Bold"
                        TextColor="#344054"/>

                    <Entry
                        Text="{Binding ConfirmPassword}"
                        Placeholder="Enter password again"
                        IsPassword="True"/>

                    <Button
                        Text="Reset password"
                        Command="{Binding ResetPasswordCommand}"
                        BackgroundColor="#00A99D"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="52"/>
                </VerticalStackLayout>
            </Border>

            <!-- Validation message -->
            <Border
                IsVisible="{Binding HasStatusMessage}"
                Padding="14"
                BackgroundColor="#FFF1F0"
                Stroke="#FDA29B"
                StrokeShape="RoundRectangle 12">

                <Label
                    Text="{Binding StatusMessage}"
                    TextColor="#B42318"
                    FontSize="14"/>
            </Border>

            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="#00A99D"
                HorizontalOptions="Center"/>

            <Label
                Text="For your security, verification codes expire after 10 minutes."
                FontSize="12"
                TextColor="#98A2B3"
                HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>