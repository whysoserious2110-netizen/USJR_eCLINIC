<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.ReadsProfilePage"
             x:DataType="vm:ReadsProfileViewModel"
             BackgroundColor="#F7F8FA">

    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,30" Spacing="20">

            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="&#8592;"
                       FontSize="22"
                       TextColor="#0F9B8E"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1"
                       Text="READS Scholar Profile"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#12212E"
                       Margin="10,0,0,0"
                       VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Frame WidthRequest="80"
                       HeightRequest="80"
                       CornerRadius="40"
                       Padding="0"
                       BackgroundColor="#E2E6EA"
                       HasShadow="False"
                       IsClippedToBounds="True">
                    <Grid>
                        <Label Text="&#128100;"
                               FontSize="36"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="#9AA4AE" />
                        <Image Source="{Binding ProfileImagePath,
                                                 Converter={StaticResource ImagePathConv}}"
                               Aspect="AspectFill" />
                    </Grid>
                </Frame>

                <Label Text="Change photo"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#0F9B8E">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePhotoCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="{Binding FullName}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#12212E"
                       HorizontalOptions="Center" />

                <Frame BackgroundColor="#D5F5EF"
                       Padding="12,5"
                       CornerRadius="12"
                       HasShadow="False">
                    <Label Text="{Binding Role}"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#0F9B8E" />
                </Frame>
            </VerticalStackLayout>

            <Frame BackgroundColor="White"
                   BorderColor="#E2E6EA"
                   CornerRadius="14"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Student Information"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#12212E" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Full Name"
                               FontSize="11"
                               TextColor="#9AA4AE" />
                        <Entry Text="{Binding FullName}"
                               IsEnabled="{Binding IsEditing}"
                               FontSize="14"
                               TextColor="#12212E" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Student ID"
                               FontSize="11"
                               TextColor="#9AA4AE" />
                        <Label Text="{Binding StudentId}"
                               FontSize="14"
                               TextColor="#12212E" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Program &amp; Year"
                               FontSize="11"
                               TextColor="#9AA4AE" />
                        <Entry Text="{Binding ProgramAndYear}"
                               IsEnabled="{Binding IsEditing}"
                               Placeholder="e.g., BS Computer Science - 3rd Year"
                               FontSize="14"
                               TextColor="#12212E" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               FontSize="11"
                               TextColor="#9AA4AE" />
                        <Label Text="{Binding Email}"
                               FontSize="14"
                               TextColor="#12212E" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mobile Number"
                               FontSize="11"
                               TextColor="#9AA4AE" />
                        <Entry Text="{Binding MobileNumber}"
                               IsEnabled="{Binding IsEditing}"
                               Placeholder="+63 9XX XXX XXXX"
                               Keyboard="Telephone"
                               FontSize="14"
                               TextColor="#12212E" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#EAF6F4"
                   BorderColor="#0F9B8E"
                   CornerRadius="14"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Clinic Role"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#12212E" />
                    <Label Text="READS Scholar"
                           FontSize="14"
                           TextColor="#0F9B8E" />
                    <Label Text="Student staff member at the university clinic."
                           FontSize="12"
                           TextColor="#4A5B63" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Edit Profile"
                    Command="{Binding ToggleEditCommand}"
                    BackgroundColor="#F0F2F4"
                    TextColor="#12212E"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="50" />

            <Button Text="Save Changes"
                    Command="{Binding SaveCommand}"
                    IsVisible="{Binding IsEditing}"
                    BackgroundColor="#0F9B8E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="50" />

            <Button Text="Log Out"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#E05B5B"
                    FontAttributes="Bold"
                    BorderColor="#E05B5B"
                    BorderWidth="1"
                    CornerRadius="26"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>