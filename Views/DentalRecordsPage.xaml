<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.DentalRecordsPage"
             x:Name="Root"
             x:DataType="vm:DentalRecordsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F8F6">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="Dental Records" FontSize="19"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <Grid Grid.Row="1" Padding="12,14,12,8">
            <VerticalStackLayout IsVisible="{Binding HasRecords, Converter={StaticResource BoolInverter}}"
                                 VerticalOptions="Center" Spacing="9">
                <Label Text="&#129688;" FontSize="40" HorizontalOptions="Center" TextColor="#9AA4AE" />
                <Label Text="No dental records yet" FontSize="15" FontAttributes="Bold"
                       TextColor="#526057" HorizontalOptions="Center" />
                <Label Text="Your dental visit history will appear here after a clinic visit."
                       FontSize="12" TextColor="#84918A" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" Margin="22,0" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Records}" IsVisible="{Binding HasRecords}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DentalRecordListItem">
                        <Border BackgroundColor="White" Stroke="#F4C400" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="11" Margin="0,0,0,9">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.ViewDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Border BackgroundColor="#FDE6EC" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6" Padding="7,3"
                                            HorizontalOptions="Start">
                                        <Label Text="DENTAL VISIT" FontSize="9" FontAttributes="Bold"
                                               TextColor="#D14C74" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding DateDisplay}" FontSize="10"
                                           TextColor="#8495B5" HorizontalOptions="End" VerticalOptions="Center" />
                                </Grid>

                                <VerticalStackLayout Spacing="1">
                                    <Label Text="EXAM FINDINGS" FontSize="9" FontAttributes="Bold" TextColor="#84918A" />
                                    <Label Text="{Binding ExamFindings}" FontSize="11" TextColor="#17221B"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="1">
                                    <Label Text="DIAGNOSIS" FontSize="9" FontAttributes="Bold" TextColor="#84918A" />
                                    <Label Text="{Binding Diagnosis}" FontSize="11" FontAttributes="Bold"
                                           TextColor="#17221B" LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="1">
                                    <Label Text="TREATMENT RENDERED" FontSize="9" FontAttributes="Bold" TextColor="#84918A" />
                                    <Label Text="{Binding TreatmentRendered}" FontSize="10" TextColor="#526057"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>

                                <BoxView HeightRequest="1" Color="#EEF1ED" Margin="0,2,0,0" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding CareInstructions}" FontSize="10"
                                           TextColor="#D14C74" VerticalOptions="Center"
                                           IsVisible="{Binding CareInstructions, Converter={StaticResource StringNotEmpty}}"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Label Grid.Column="1" Text="Details  &#8250;" FontSize="11"
                                           FontAttributes="Bold" TextColor="#087A3D" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" Color="#E7EBEF" HeightRequest="1" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,8,0,5">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#8962;" FontSize="20" TextColor="#087A3D" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" FontAttributes="Bold" TextColor="#087A3D" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Appointments" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128276;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Notifications" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
