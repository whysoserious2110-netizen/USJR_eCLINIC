<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.PrescriptionDetailPage"
             x:DataType="vm:PrescriptionListItem"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F8F6">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#176B38" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="{StaticResource Typography.PageTitle}"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="Prescription Details" FontSize="{StaticResource Typography.Section}"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,14,14,20" Spacing="12">
                <Border BackgroundColor="#FFF4C7" Stroke="#F4C400" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14">
                    <VerticalStackLayout Spacing="7">
                        <Border BackgroundColor="{Binding LabelBackgroundColor}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8" Padding="8,4" HorizontalOptions="Start">
                            <Label Text="{Binding LabelText}" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold"
                                   TextColor="{Binding LabelForegroundColor}" />
                        </Border>
                        <Label Text="{Binding MedicineName}" FontSize="{StaticResource Typography.PageTitle}" FontAttributes="Bold"
                               TextColor="#17221B" />
                        <Label Text="{Binding DateDisplay, StringFormat='Prescribed on {0}'}"
                               FontSize="{StaticResource Typography.Caption}" TextColor="#526057" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="PRESCRIPTION INFORMATION" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#68756D" />
                    <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="14">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="100,*" Padding="0,5">
                                <Label Text="DOSAGE" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#84918A" />
                                <Label Grid.Column="1" Text="{Binding Dosage}" FontSize="{StaticResource Typography.Body}" TextColor="#17221B" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#EEF1ED" />
                            <Grid ColumnDefinitions="100,*" Padding="0,10,0,5">
                                <Label Text="QUANTITY" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#84918A" />
                                <Label Grid.Column="1" Text="{Binding Quantity}" FontSize="{StaticResource Typography.Body}" TextColor="#17221B" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#EEF1ED" />
                            <Grid ColumnDefinitions="100,*" Padding="0,10,0,5">
                                <Label Text="DATE" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#84918A" />
                                <Label Grid.Column="1" Text="{Binding DateDisplay}" FontSize="{StaticResource Typography.Body}" TextColor="#17221B" />
                            </Grid>
                            <Grid ColumnDefinitions="100,*" Padding="0,10,0,5"
                                  IsVisible="{Binding HasPrescriber}">
                                <Label Text="PRESCRIBED BY" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#84918A" />
                                <Label Grid.Column="1" Text="{Binding PrescribedBy}" FontSize="{StaticResource Typography.Body}" TextColor="#17221B" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasInstructions}" Spacing="8">
                    <Label Text="USAGE INSTRUCTIONS" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#68756D" />
                    <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="14">
                        <Label Text="{Binding Instructions}" FontSize="{StaticResource Typography.Body}" TextColor="#17221B" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsClinicGiven}" Spacing="8">
                    <Label Text="DISPENSING STATUS" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#68756D" />
                    <Border BackgroundColor="#D5F5EF" Stroke="#BFE8DE" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding DispensingStatus}" FontSize="{StaticResource Typography.Body}" FontAttributes="Bold"
                                   TextColor="#087A3D" />
                            <Label Text="{Binding DispensedDateDisplay, StringFormat='Dispensed: {0}'}"
                                   FontSize="{StaticResource Typography.Caption}" TextColor="#526057" IsVisible="{Binding HasDispensedDate}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" Color="#E7EBEF" HeightRequest="1" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,8,0,5">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#8962;" FontSize="{StaticResource Typography.PageTitle}" TextColor="#087A3D" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="{StaticResource Typography.Caption}" FontAttributes="Bold" TextColor="#087A3D" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="{StaticResource Typography.Section}" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Appointments" FontSize="{StaticResource Typography.Caption}" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128276;" FontSize="{StaticResource Typography.Section}" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Notifications" FontSize="{StaticResource Typography.Caption}" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="{StaticResource Typography.Section}" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="{StaticResource Typography.Caption}" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
