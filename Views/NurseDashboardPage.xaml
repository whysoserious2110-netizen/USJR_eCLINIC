<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             x:Class="USJR_eCLINIC.Views.NurseDashboardPage"
             x:Name="Root"
             x:DataType="vm:NurseDashboardViewModel"
             BackgroundColor="#F5F7F9">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="0,0,0,20" Spacing="14">
                <Grid RowDefinitions="Auto,6" Margin="0,0,0,0">
                    <Border Grid.Row="0" BackgroundColor="#176B38" StrokeThickness="0" Padding="20,36,20,15">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Frame WidthRequest="58" HeightRequest="58" BackgroundColor="#E8F6F4"
                                   BorderColor="#F4C400" CornerRadius="29" Padding="0" HasShadow="False" IsClippedToBounds="True">
                                <Grid>
                                    <Label Text="&#128100;" FontSize="24" TextColor="#087A3D"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}"
                                           Aspect="AspectFill" />
                                </Grid>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Welcome back" FontSize="13" TextColor="#E5F4E9" />
                                <Label Text="{Binding NurseName}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                <Label Text="NURSE" FontSize="10" FontAttributes="Bold" TextColor="#F4C400" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="6" />
                </Grid>

                <Border IsVisible="{Binding HasAnnouncement}" Margin="16,0" BackgroundColor="#FFF7E2"
                        Stroke="#F2D995" StrokeThickness="1" Padding="14"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#9432;" FontSize="18" TextColor="#A87917" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding AnnouncementText}" FontSize="13"
                               TextColor="#5A4A1E" />
                    </Grid>
                </Border>

                <!-- One hierarchical, clickable Today's Clinic Summary panel -->
                <Border BackgroundColor="#087A3D" Stroke="#087A3D" StrokeThickness="1"
                        Padding="11,10" Margin="16,0" StrokeShape="RoundRectangle 16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Today's Clinic Summary" FontSize="14"
                                       FontAttributes="Bold" TextColor="White" />
                                <Label Text="{Binding SummaryDateText}" FontSize="10" TextColor="#E5F4E9" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="OPEN QUEUE" FontSize="9" FontAttributes="Bold" TextColor="#F4C400" />
                                <Label Text="›" FontSize="16" FontAttributes="Bold" TextColor="#F4C400" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="1.1*,2,*,2,*,2,*" ColumnSpacing="5">
                            <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding TodayPatientCount}" FontSize="24"
                                       FontAttributes="Bold" TextColor="White" />
                                <Label Text="Today's visits" FontSize="9" TextColor="#E5F4E9" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="32" BackgroundColor="#55A274" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding AwaitingVitalsCount}" FontSize="15"
                                       FontAttributes="Bold" TextColor="#F4C400" />
                                <Label Text="Awaiting vitals" FontSize="8" TextColor="#E5F4E9" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="32" BackgroundColor="#55A274" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="4" Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding VitalsRecordedCount}" FontSize="15"
                                       FontAttributes="Bold" TextColor="White" />
                                <Label Text="Vitals recorded" FontSize="8" TextColor="#E5F4E9" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="5" WidthRequest="1" HeightRequest="32" BackgroundColor="#55A274" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="6" Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding CompletedTodayCount}" FontSize="15"
                                       FontAttributes="Bold" TextColor="#F4C400" />
                                <Label Text="Completed" FontSize="8" TextColor="#E5F4E9" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="18,2,18,0">
                    <Label Text="Nurse Workbench" FontSize="17" FontAttributes="Bold" TextColor="#172B3A" />
                    <Label Grid.Column="1" Text="CLINIC TOOLS" FontSize="10" FontAttributes="Bold"
                           TextColor="#91A0AC" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" Margin="16,0">
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" Stroke="#D9E8DD"
                            StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPatientRecordCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#FFF4C7"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                <Label Text="&#128203;" FontSize="21" TextColor="#087A3D"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Patient Records" FontSize="14" FontAttributes="Bold" TextColor="#087A3D" />
                            <Label Text="Patients with saved consultations" FontSize="11" TextColor="#72808D" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" Stroke="#D9E8DD"
                            StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToInventoryCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#FFF4C7"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                <Label Text="&#128138;" FontSize="21" TextColor="#087A3D"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Medicine Inventory" FontSize="14" FontAttributes="Bold" TextColor="#087A3D" />
                            <Label Text="{Binding LowStockCount, StringFormat='{0} low-stock items'}"
                                   FontSize="11" TextColor="#B64D4D" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" Stroke="#D9E8DD"
                            StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToDispensingCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#FFF4C7"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                <Label Text="&#128137;" FontSize="21" TextColor="#087A3D"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Dispensing" FontSize="14" FontAttributes="Bold" TextColor="#087A3D" />
                            <Label Text="{Binding PendingDispenseCount, StringFormat='{0} pending clinic doses'}"
                                   FontSize="11" TextColor="#A97816" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#D9E8DD"
                            StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToApeEncodingCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#FFF4C7"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 11">
                                <Label Text="&#129514;" FontSize="21" TextColor="#087A3D"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="APE Lab Encoding" FontSize="14" FontAttributes="Bold" TextColor="#087A3D" />
                            <Label Text="Eligible staff · verified reports only" FontSize="11" TextColor="#72808D" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" Stroke="#E1E7EC" StrokeThickness="1"
                Padding="4,8" StrokeShape="RoundRectangle 0">
            <Grid ColumnDefinitions="*,*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="&#8962;" FontSize="18" TextColor="#087A3D" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="11" TextColor="#087A3D" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#9AA6B2" HorizontalOptions="Center" />
                    <Label Text="Triage" FontSize="11" TextColor="#72808D" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Grid Grid.Column="2" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="&#128276;" FontSize="18" TextColor="#9AA6B2" HorizontalOptions="Center" />
                        <Label Text="Notifications" FontSize="11" TextColor="#72808D" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border IsVisible="{Binding HasUnreadNotifications}" BackgroundColor="#D9534F"
                            StrokeThickness="0" StrokeShape="RoundRectangle 9" WidthRequest="18" HeightRequest="18"
                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,-4,8,0">
                        <Label Text="{Binding UnreadNotificationCount}" FontSize="10" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#9AA6B2" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="11" TextColor="#72808D" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
