<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.DatePickerPopupPage"
             x:Name="Root"
             x:DataType="vm:BookAppointmentViewModel"
             BackgroundColor="#66000000">

    <Grid VerticalOptions="Center" Padding="24">
        <Frame BackgroundColor="White" CornerRadius="24" Padding="0" HasShadow="True" BorderColor="Transparent">
            <VerticalStackLayout Spacing="0">

                <Frame CornerRadius="24,24,0,0" Padding="18,16" HasShadow="False" BorderColor="Transparent">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0F9B8E" Offset="0.0"/>
                            <GradientStop Color="#12B5A5" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0" BackgroundColor="#1FFFFFFF" CornerRadius="18" Padding="0"
                               WidthRequest="34" HeightRequest="34" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#8249;" FontSize="18" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousMonthCommand}"/>
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Label Grid.Column="1" Text="{Binding CurrentMonthLabel}" FontSize="17" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>

                        <Frame Grid.Column="2" BackgroundColor="#1FFFFFFF" CornerRadius="18" Padding="0"
                               WidthRequest="34" HeightRequest="34" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#8250;" FontSize="18" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextMonthCommand}"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>
                </Frame>

                <VerticalStackLayout Padding="16,14" Spacing="12">

                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                        <Label Grid.Column="0" Text="S" FontSize="11" FontAttributes="Bold" TextColor="#B7BEC5" HorizontalOptions="Center"/>
                        <Label Grid.Column="1" Text="M" FontSize="11" FontAttributes="Bold" TextColor="#B7BEC5" HorizontalOptions="Center"/>
                        <Label Grid.Column="2" Text="T" FontSize="11" FontAttributes="Bold" TextColor="#B7BEC5" HorizontalOptions="Center"/>
                        <Label Grid.Column="3" Text="W" FontSize="11" FontAttributes="Bold" TextColor="#B7BEC5" HorizontalOptions="Center"/>
                        <Label Grid.Column="4" Text="T" FontSize="11" FontAttributes="Bold" TextColor="#B7BEC5" HorizontalOptions="Center"/>
                        <Label Grid.Column="5" Text="F" FontSize="11" FontAttributes="Bold" TextColor="#B7BEC5" HorizontalOptions="Center"/>
                        <Label Grid.Column="6" Text="S" FontSize="11" FontAttributes="Bold" TextColor="#B7BEC5" HorizontalOptions="Center"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding CalendarDays}" HeightRequest="270">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="6"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarDayCell">
                                <Frame BackgroundColor="{Binding CellBackgroundColor}"
                                       BorderColor="{Binding CellBorderColor}"
                                       CornerRadius="18" Padding="0" HeightRequest="36" WidthRequest="36"
                                       HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectDateAndCloseCommand}" CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <Label Text="{Binding DayNumber}" TextColor="{Binding TextColor}"
                                           FontSize="13" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" BackgroundColor="#F0F2F4" Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                        <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" Fill="#2E6FDB" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Available" FontSize="11" TextColor="#6B7684" VerticalOptions="Center"/>
                        <Ellipse Grid.Column="2" WidthRequest="10" HeightRequest="10" Fill="#E05B5B" VerticalOptions="Center" Margin="8,0,0,0"/>
                        <Label Grid.Column="3" Text="Unavailable" FontSize="11" TextColor="#6B7684" VerticalOptions="Center"/>
                    </Grid>

                    <Button Text="Close" Command="{Binding ClosePopupCommand}"
                            BackgroundColor="#F0F2F4" TextColor="#12212E" FontAttributes="Bold"
                            CornerRadius="20" HeightRequest="44" Margin="0,6,0,0"/>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>