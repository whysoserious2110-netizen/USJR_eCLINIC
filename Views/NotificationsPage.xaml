<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.NotificationsPage"
             x:Name="Root"
             x:DataType="vm:NotificationsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="#F7F8F6">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#176B38" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="Notifications" FontSize="19"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <Border Grid.Row="1" BackgroundColor="#F4C400" StrokeThickness="0"
                StrokeShape="RoundRectangle 0" Padding="5,4">
            <Grid ColumnDefinitions="*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="4" Padding="4,5"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="All"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="All" FontSize="12" FontAttributes="Bold"
                           TextColor="#087A3D" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="2" WidthRequest="42" Color="#087A3D"
                             IsVisible="{Binding IsAllSelected}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="4,5"
                                     HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="Unread"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="{Binding UnreadFilterLabel}" FontSize="12" FontAttributes="Bold"
                           TextColor="#087A3D" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="2" WidthRequest="62" Color="#087A3D"
                             IsVisible="{Binding IsUnreadSelected}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" Padding="16,12,16,10" RowSpacing="8">
            <Label Grid.Row="0" Text="Tap a notification to read its details. Swipe left to delete it."
                   FontSize="10" TextColor="#68756D" IsVisible="{Binding HasNotifications}" />

            <VerticalStackLayout Grid.Row="1"
                                 IsVisible="{Binding HasNotifications, Converter={StaticResource BoolInverter}}"
                                 VerticalOptions="Center" Spacing="9">
                <Label Text="&#128276;" FontSize="38" HorizontalOptions="Center" TextColor="#9AA4AE" />
                <Label Text="No notifications in this view" FontSize="14" FontAttributes="Bold"
                       TextColor="#526057" HorizontalOptions="Center" />
                <Label Text="Appointment reminders and clinic updates will appear here."
                       FontSize="11" TextColor="#9AA4AE" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" Margin="24,0" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Notifications}"
                            IsVisible="{Binding HasNotifications}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationListItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="#B42318"
                                               Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteNotificationCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="11" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenNotificationCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="8" RowSpacing="3">
                                    <Border Grid.RowSpan="3" WidthRequest="30" HeightRequest="30"
                                            BackgroundColor="#E5F7EF" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8">
                                        <Label Text="&#128276;" FontSize="14" TextColor="#087A3D"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold"
                                           FontSize="11" TextColor="#17221B" LineBreakMode="TailTruncation"/>
                                    <Ellipse Grid.Column="2" WidthRequest="8" HeightRequest="8"
                                             Fill="#E94F70" VerticalOptions="Center"
                                             IsVisible="{Binding IsRead, Converter={StaticResource BoolInverter}}"/>
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Message}"
                                           FontSize="9" TextColor="#526057" LineBreakMode="TailTruncation"
                                           MaxLines="2"/>
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding DateDisplay}"
                                           FontSize="8" TextColor="#84918A" Margin="0,1,0,0"/>
                                    <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="Read details  &#8250;" FontSize="9" FontAttributes="Bold"
                                           TextColor="#087A3D" Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
