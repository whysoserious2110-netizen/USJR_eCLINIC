<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.WriteRxPage"
             x:Name="Root"
             x:DataType="vm:WriteRxViewModel"
             BackgroundColor="#F7F8FA">

    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,30" Spacing="18">

            <Grid RowDefinitions="Auto,7" Margin="-20,-50,-20,0">
    <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
            StrokeShape="Rectangle" Padding="18,50,18,14">
        <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                    TextColor="#087A3D" BackgroundColor="#F4C400"
                    CornerRadius="9" WidthRequest="40" HeightRequest="40"
                    Padding="0" Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="Write Prescription" FontSize="18"
                   FontAttributes="Bold" TextColor="#F4C400"
                   VerticalOptions="Center" />
        </Grid>
    </Border>
    <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
</Grid>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasPresetPatient}">
                <Label Text="Prescription for" FontSize="13" FontAttributes="Bold" TextColor="#12212E"/>
                <Frame BackgroundColor="#E5F3EA" BorderColor="#B9D8C2" CornerRadius="12" Padding="12" HasShadow="False">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding PresetPatientName}" FontSize="14" FontAttributes="Bold" TextColor="#087A3D"/>
                        <Label Text="Patient selected from the active consultation" FontSize="11" TextColor="#647067"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasPresetPatient, Converter={StaticResource BoolInverter}}">
                <Label Text="Patient" FontSize="13" FontAttributes="Bold" TextColor="#12212E"/>
                <Label Text="Only patients with a consultation record or a checked-in visit are listed."
                       FontSize="11" TextColor="#647067"/>
                <Frame IsVisible="{Binding HasEligiblePatients}" BackgroundColor="White" BorderColor="#E2E6EA"
                       CornerRadius="12" Padding="10,0" HeightRequest="52" HasShadow="False">
                    <Picker ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}"
                            ItemDisplayBinding="{Binding DisplayName}" Title="Select patient" VerticalOptions="Center"/>
                </Frame>
                <Frame IsVisible="{Binding HasEligiblePatients, Converter={StaticResource BoolInverter}}"
                       BackgroundColor="#FFF4C7" BorderColor="#E8CF5A" CornerRadius="12" Padding="12"
                       HasShadow="False">
                    <Label Text="No eligible patients yet. A patient must have a consultation on record or be checked in before a prescription can be started."
                           FontSize="12" TextColor="#514A2C"/>
                </Frame>
            </VerticalStackLayout>
            <Label Text="Medicines" FontSize="15" FontAttributes="Bold" TextColor="#12212E" Margin="0,6,0,0"/>

            <CollectionView ItemsSource="{Binding Medicines}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MedicineEntry">
                        <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14" Padding="16" Margin="0,0,0,14" HasShadow="False">
                            <VerticalStackLayout Spacing="10">

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Medicine Name" FontSize="12" FontAttributes="Bold" TextColor="#12212E"/>
                                    <Entry Placeholder="e.g., Paracetamol" Text="{Binding MedicineName}"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Dosage" FontSize="12" FontAttributes="Bold" TextColor="#12212E"/>
                                    <Entry Placeholder="e.g., 500mg, 3x daily" Text="{Binding Dosage}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Quantity (units)" FontSize="12" FontAttributes="Bold" TextColor="#12212E"/>
                                    <Entry Placeholder="e.g., 10 tablets" Text="{Binding Quantity}" Keyboard="Numeric"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Instructions (optional)" FontSize="12" FontAttributes="Bold" TextColor="#12212E"/>
                                    <Editor Placeholder="e.g., Take after meals" Text="{Binding Instructions}" HeightRequest="60"/>
                                </VerticalStackLayout>

                                <Label Text="Dispensing Type" FontSize="12" FontAttributes="Bold" TextColor="#12212E"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                    <Frame Grid.Column="0" BackgroundColor="White" BorderColor="#E2E6EA"
                                           CornerRadius="10" Padding="0" HeightRequest="42" HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleGivenTypeCommand}"/>
                                        </Frame.GestureRecognizers>
                                        <Frame.Triggers>
                                            <DataTrigger TargetType="Frame" Binding="{Binding IsClinicGiven}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#0F9B8E"/>
                                                <Setter Property="BorderColor" Value="#0F9B8E"/>
                                            </DataTrigger>
                                        </Frame.Triggers>
                                        <Label Text="Clinic-Given" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsClinicGiven}" Value="True">
                                                    <Setter Property="TextColor" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsClinicGiven}" Value="False">
                                                    <Setter Property="TextColor" Value="#12212E"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Frame>

                                    <Frame Grid.Column="1" BackgroundColor="White" BorderColor="#E2E6EA"
                                           CornerRadius="10" Padding="0" HeightRequest="42" HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleGivenTypeCommand}"/>
                                        </Frame.GestureRecognizers>
                                        <Frame.Triggers>
                                            <DataTrigger TargetType="Frame" Binding="{Binding IsClinicGiven}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#D9A441"/>
                                                <Setter Property="BorderColor" Value="#D9A441"/>
                                            </DataTrigger>
                                        </Frame.Triggers>
                                        <Label Text="Take-Home" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsClinicGiven}" Value="False">
                                                    <Setter Property="TextColor" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsClinicGiven}" Value="True">
                                                    <Setter Property="TextColor" Value="#12212E"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Frame>

                                </Grid>

                                <Label Text="Remove this medicine" FontSize="11" TextColor="#E05B5B" HorizontalOptions="End">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveMedicineCommand}" CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </Label>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="+ Add Another Medicine"
                    Command="{Binding AddAnotherMedicineCommand}"
                    BackgroundColor="White"
                    TextColor="#0F9B8E"
                    BorderColor="#0F9B8E"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="44"/>

            <Button Text="Save Prescription"
                    Command="{Binding SavePrescriptionCommand}"
                    BackgroundColor="#0F9B8E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="54"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
