<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.TodaysOverviewPage"
             x:DataType="vm:TodaysOverviewViewModel"
             BackgroundColor="#F7F8FA">

    <VerticalStackLayout Padding="20,50,20,20" Spacing="18">

        <Grid ColumnDefinitions="Auto,*">
            <Label Grid.Column="0" Text="&#8592;" FontSize="22" TextColor="#0F9B8E" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Today's Overview" FontSize="20" FontAttributes="Bold"
                   TextColor="#12212E" Margin="10,0,0,0" VerticalOptions="Center"/>
        </Grid>

        <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="16" Padding="20" HasShadow="False">
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="{Binding TotalAppointments}" FontSize="34" FontAttributes="Bold" TextColor="#0F9B8E" HorizontalOptions="Center"/>
                <Label Text="Total Appointments Today" FontSize="13" TextColor="#6B7684" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <Frame Grid.Column="0" BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="{Binding CheckedInCount}" FontSize="26" FontAttributes="Bold" TextColor="#0F9B8E" HorizontalOptions="Center"/>
                    <Label Text="Checked In" FontSize="12" TextColor="#6B7684" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Column="1" BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="{Binding PendingApprovalCount}" FontSize="26" FontAttributes="Bold" TextColor="#D9A441" HorizontalOptions="Center"/>
                    <Label Text="Pending Approval" FontSize="12" TextColor="#6B7684" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </VerticalStackLayout>
</ContentPage>