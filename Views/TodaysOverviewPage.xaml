<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.TodaysOverviewPage"
             x:Name="Root"
             x:DataType="vm:TodaysOverviewViewModel"
             BackgroundColor="#F5F7FA">

    <Grid Padding="20,42,20,12"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="14">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Label Grid.Column="0"
                   Text="&#8592;"
                   FontSize="24"
                   TextColor="#0F9B8E"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 VerticalOptions="Center">
                <Label Text="Today's Clinic"
                       FontSize="21"
                       FontAttributes="Bold"
                       TextColor="#12212E" />
                <Label Text="{Binding TodayDisplay}"
                       FontSize="12"
                       TextColor="#7B8794" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="&#8635;"
                    Command="{Binding RefreshDashboardCommand}"
                    BackgroundColor="White"
                    TextColor="#0F9B8E"
                    FontSize="22"
                    CornerRadius="12"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Pending requests are for all dates, not only today. -->
        <Frame Grid.Row="1"
               BackgroundColor="#FFF8E9"
               BorderColor="#F0D9A8"
               CornerRadius="14"
               Padding="14"
               HasShadow="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="3"
                                     VerticalOptions="Center">
                    <Label Text="Pending requests"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#6D511B" />
                    <Label Text="All appointment dates"
                           FontSize="11"
                           TextColor="#927443" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="6"
                                     HorizontalOptions="End"
                                     VerticalOptions="Center">
                    <Label Text="{Binding PendingApprovalCount}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#A87518"
                           HorizontalOptions="Center" />
                    <Button Text="Review"
                            IsVisible="{Binding HasPendingApprovals}"
                            Command="{Binding ReviewPendingRequestsCommand}"
                            BackgroundColor="#E6B449"
                            TextColor="#38280B"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="34"
                            Padding="12,0" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Today's counts -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="9">
            <Frame Grid.Column="0"
                   BackgroundColor="White"
                   BorderColor="#E2E8EF"
                   CornerRadius="14"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding TodayAppointmentCount}"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#0F9B8E" />
                    <Label Text="Visits today"
                           FontSize="10"
                           TextColor="#687585" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="1"
                   BackgroundColor="White"
                   BorderColor="#E2E8EF"
                   CornerRadius="14"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding CheckedInTodayCount}"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#2E6FDB" />
                    <Label Text="Checked in"
                           FontSize="10"
                           TextColor="#687585" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="2"
                   BackgroundColor="White"
                   BorderColor="#E2E8EF"
                   CornerRadius="14"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding CompletedTodayCount}"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#4A90D9" />
                    <Label Text="Completed"
                           FontSize="10"
                           TextColor="#687585" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Time-ordered visit list -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Text="Today's visits"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#12212E"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="In time order"
                       FontSize="11"
                       TextColor="#8793A0"
                       VerticalOptions="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <CollectionView ItemsSource="{Binding Visits}"
                                IsVisible="{Binding HasVisits}"
                                SelectionMode="None"
                                ItemsUpdatingScrollMode="KeepScrollOffset">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TodaysOverviewVisitItem">
                            <Frame BackgroundColor="White"
                                   BorderColor="#E2E8EF"
                                   CornerRadius="15"
                                   Padding="15"
                                   HasShadow="False">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="3"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding PatientName}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#12212E"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding PatientIdNumber}"
                                                   FontSize="11"
                                                   TextColor="#8793A0" />
                                        </VerticalStackLayout>

                                        <Frame Grid.Column="1"
                                               BackgroundColor="{Binding StatusColor}"
                                               CornerRadius="11"
                                               Padding="9,5"
                                               HasShadow="False"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding StatusDisplay}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                        </Frame>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="TIME"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="#8A96A3" />
                                            <Label Text="{Binding TimeDisplay}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F9B8E" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding ServiceType}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#526171" />
                                            <Label Text="{Binding SubService}"
                                                   FontSize="12"
                                                   TextColor="#687585"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Frame IsVisible="{Binding HasQueueNumber}"
                                           BackgroundColor="#EEF3FF"
                                           CornerRadius="9"
                                           Padding="10,6"
                                           HasShadow="False"
                                           HorizontalOptions="Start">
                                        <Label Text="{Binding QueueNumberDisplay}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#2E6FDB" />
                                    </Frame>

                                    <Button Text="Check In Patient"
                                            IsVisible="{Binding CanCheckIn}"
                                            Command="{Binding Source={x:Reference Root},
                                                              Path=BindingContext.CheckInVisitCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#0F9B8E"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="12"
                                            HeightRequest="44" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout IsVisible="{Binding HasVisits,
                                                        Converter={StaticResource BoolInverter}}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8"
                                     Padding="24">
                    <Label Text="&#128197;"
                           FontSize="40"
                           HorizontalOptions="Center"
                           TextColor="#B8C2CC" />
                    <Label Text="No visits scheduled today"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#526171"
                           HorizontalOptions="Center" />
                    <Label Text="Confirmed appointments will appear here."
                           FontSize="12"
                           TextColor="#8793A0"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>