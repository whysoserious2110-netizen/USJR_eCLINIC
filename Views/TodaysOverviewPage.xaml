<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.TodaysOverviewPage"
             x:Name="Root"
             x:DataType="vm:TodaysOverviewViewModel"
             BackgroundColor="#F5F7FA">

    <Grid Padding="14,16,14,12"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="14">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Border BackgroundColor="#176B38" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" Padding="12,10">
                <Grid ColumnDefinitions="42,*,44" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;"
                            Command="{Binding GoBackCommand}"
                            FontSize="{StaticResource Typography.PageTitle}" TextColor="#087A3D"
                            BackgroundColor="#F4C400" CornerRadius="9"
                            WidthRequest="38" HeightRequest="38" Padding="0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Today's Clinic" FontSize="{StaticResource Typography.Section}"
                               FontAttributes="Bold" TextColor="#F4C400" />
                        <Label Text="{Binding TodayDisplay}" FontSize="{StaticResource Typography.Caption}" TextColor="#E9F3EC" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="&#8635;"
                            Command="{Binding RefreshDashboardCommand}"
                            BackgroundColor="#F4C400" TextColor="#087A3D"
                            FontSize="{StaticResource Typography.PageTitle}" CornerRadius="10"
                            WidthRequest="38" HeightRequest="38" Padding="0" />
                </Grid>
            </Border>
            <BoxView HeightRequest="5" Color="#F4C400"/>
        </VerticalStackLayout>
        <!-- Pending requests are for all dates, not only today. -->
        <Frame Grid.Row="1"
               BackgroundColor="#FFF8E9"
               BorderColor="#F0D9A8"
               CornerRadius="14"
               Padding="14"
               HasShadow="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="3"
                                     VerticalOptions="Center">
                    <Label Text="Pending requests"
                           FontSize="{StaticResource Typography.Body}"
                           FontAttributes="Bold"
                           TextColor="#6D511B" />
                    <Label Text="All appointment dates"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#927443" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="6"
                                     HorizontalOptions="End"
                                     VerticalOptions="Center">
                    <Label Text="{Binding PendingApprovalCount}"
                           FontSize="{StaticResource Typography.PageTitle}"
                           FontAttributes="Bold"
                           TextColor="#A87518"
                           HorizontalOptions="Center" />
                    <Button Text="Review"
                            IsVisible="{Binding HasPendingApprovals}"
                            Command="{Binding ReviewPendingRequestsCommand}"
                            BackgroundColor="#E6B449"
                            TextColor="#38280B"
                            FontSize="{StaticResource Typography.Caption}"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="34"
                            Padding="12,0" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Today's counts -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="9">
            <Frame Grid.Column="0"
                   BackgroundColor="White"
                   BorderColor="#E2E8EF"
                   CornerRadius="14"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding TodayAppointmentCount}"
                           FontSize="{StaticResource Typography.Headline}"
                           FontAttributes="Bold"
                           TextColor="#0F9B8E" />
                    <Label Text="Visits today"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#687585" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="1"
                   BackgroundColor="White"
                   BorderColor="#E2E8EF"
                   CornerRadius="14"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding CheckedInTodayCount}"
                           FontSize="{StaticResource Typography.Headline}"
                           FontAttributes="Bold"
                           TextColor="#2E6FDB" />
                    <Label Text="Checked in"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#687585" />
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Column="2"
                   BackgroundColor="White"
                   BorderColor="#E2E8EF"
                   CornerRadius="14"
                   Padding="12"
                   HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding CompletedTodayCount}"
                           FontSize="{StaticResource Typography.Headline}"
                           FontAttributes="Bold"
                           TextColor="#4A90D9" />
                    <Label Text="Completed"
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#687585" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- Time-ordered visit list -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Text="Today's visits"
                       FontSize="{StaticResource Typography.Emphasis}"
                       FontAttributes="Bold"
                       TextColor="#12212E"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="In time order"
                       FontSize="{StaticResource Typography.Caption}"
                       TextColor="#8793A0"
                       VerticalOptions="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <CollectionView ItemsSource="{Binding Visits}"
                                IsVisible="{Binding HasVisits}"
                                SelectionMode="None"
                                ItemsUpdatingScrollMode="KeepScrollOffset">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TodaysOverviewVisitItem">
                            <Frame BackgroundColor="White"
                                   BorderColor="#E2E8EF"
                                   CornerRadius="15"
                                   Padding="15"
                                   HasShadow="False">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="3"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding PatientName}"
                                                   FontSize="{StaticResource Typography.Body}"
                                                   FontAttributes="Bold"
                                                   TextColor="#12212E"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding PatientIdNumber}"
                                                   FontSize="{StaticResource Typography.Caption}"
                                                   TextColor="#8793A0" />
                                        </VerticalStackLayout>

                                        <Frame Grid.Column="1"
                                               BackgroundColor="{Binding StatusColor}"
                                               CornerRadius="11"
                                               Padding="9,5"
                                               HasShadow="False"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding StatusDisplay}"
                                                   FontSize="{StaticResource Typography.Caption}"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                        </Frame>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="TIME"
                                                   FontSize="{StaticResource Typography.Caption}"
                                                   FontAttributes="Bold"
                                                   TextColor="#8A96A3" />
                                            <Label Text="{Binding TimeDisplay}"
                                                   FontSize="{StaticResource Typography.Body}"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F9B8E" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding ServiceType}"
                                                   FontSize="{StaticResource Typography.Caption}"
                                                   FontAttributes="Bold"
                                                   TextColor="#526171" />
                                            <Label Text="{Binding SubService}"
                                                   FontSize="{StaticResource Typography.Caption}"
                                                   TextColor="#687585"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Frame IsVisible="{Binding HasQueueNumber}"
                                           BackgroundColor="#EEF3FF"
                                           CornerRadius="9"
                                           Padding="10,6"
                                           HasShadow="False"
                                           HorizontalOptions="Start">
                                        <Label Text="{Binding QueueNumberDisplay}"
                                               FontSize="{StaticResource Typography.Caption}"
                                               FontAttributes="Bold"
                                               TextColor="#2E6FDB" />
                                    </Frame>


                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout IsVisible="{Binding HasVisits,
                                                        Converter={StaticResource BoolInverter}}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8"
                                     Padding="24">
                    <Label Text="&#128197;"
                           FontSize="{StaticResource Typography.Display}"
                           HorizontalOptions="Center"
                           TextColor="#B8C2CC" />
                    <Label Text="No visits scheduled today"
                           FontSize="{StaticResource Typography.Emphasis}"
                           FontAttributes="Bold"
                           TextColor="#526171"
                           HorizontalOptions="Center" />
                    <Label Text="Confirmed appointments will appear here."
                           FontSize="{StaticResource Typography.Caption}"
                           TextColor="#8793A0"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>