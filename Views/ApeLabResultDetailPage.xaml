<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.ApeLabResultDetailPage"
             x:DataType="vm:ApeLabResultItem"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F8F6">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="APE LAB Details" FontSize="19"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,16,14,20" Spacing="13">
                <Border BackgroundColor="#2C9057" Stroke="#69A87A" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border BackgroundColor="#D5F5EF" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 7" Padding="8,4"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="{Binding Category}" FontSize="10" FontAttributes="Bold"
                                       TextColor="#087A3D" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding DateDisplay, StringFormat='Issued: {0}'}"
                                   FontSize="11" TextColor="White" VerticalOptions="Center"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                        <Label Text="{Binding ResultTitle}" FontSize="20" FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="{Binding PatientName}" FontSize="12" TextColor="#E6F1E8" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="RESULT DETAILS" FontSize="12" FontAttributes="Bold"
                           TextColor="#68756D" />
                    <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="15">
                        <Label Text="{Binding ResultText}" FontSize="14" TextColor="#17221B"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding ShowOverallFindings}" Spacing="8">
                    <Label Text="OVERALL APE FINDINGS" FontSize="12" FontAttributes="Bold"
                           TextColor="#68756D" />
                    <Border BackgroundColor="#FFF7D6" Stroke="#F4C400" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="15">
                        <Label Text="{Binding OverallFindings}" FontSize="13" TextColor="#314438"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="RECORD INFORMATION" FontSize="12" FontAttributes="Bold"
                           TextColor="#68756D" />
                    <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="Account type" FontSize="12" TextColor="#68756D" />
                                <Label Grid.Column="1" Text="{Binding PatientRole}" FontSize="12"
                                       FontAttributes="Bold" TextColor="#17221B"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#EEF1ED" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                  IsVisible="{Binding HasEncodedBy}">
                                <Label Text="Encoded by" FontSize="12" TextColor="#68756D" />
                                <Label Grid.Column="1" Text="{Binding EncodedBy}" FontSize="12"
                                       FontAttributes="Bold" TextColor="#17221B"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="If you have questions about these results, contact the USJ-R Clinic."
                       FontSize="11" TextColor="#68756D" HorizontalTextAlignment="Center"
                       Margin="8,0,8,0" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" Color="#E7EBEF" HeightRequest="1" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,8,0,5">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#8962;" FontSize="20" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Appointments" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128276;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Notifications" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
