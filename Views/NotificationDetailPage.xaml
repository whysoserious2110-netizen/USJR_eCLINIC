<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.NotificationDetailPage"
             x:DataType="vm:NotificationDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F8F6">

    <Grid RowDefinitions="Auto,*" BackgroundColor="#F7F8F6">
        <Grid Grid.Row="0" RowDefinitions="Auto,7">
            <Border Grid.Row="0" BackgroundColor="#2C9057" StrokeThickness="0"
                    StrokeShape="Rectangle" Padding="18,50,18,14">
                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="&#8592;" FontSize="21"
                            TextColor="#087A3D" BackgroundColor="#F4C400"
                            CornerRadius="9" WidthRequest="40" HeightRequest="40"
                            Padding="0" Command="{Binding GoBackCommand}" />
                    <Label Grid.Column="1" Text="Notification Details" FontSize="19"
                           FontAttributes="Bold" TextColor="#F4C400"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            <BoxView Grid.Row="1" Color="#F4C400" HeightRequest="7" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,24" Spacing="16">
                <Border BackgroundColor="#FFF4C7" Stroke="#E8CF5A" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                            <Border BackgroundColor="#F4C400" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11" WidthRequest="40" HeightRequest="40"
                                    Padding="0" VerticalOptions="Center">
                                <Label Text="&#128276;" FontSize="20" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold"
                                   FontSize="19" TextColor="#17221B" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="RECEIVED" FontSize="10" FontAttributes="Bold" TextColor="#68756D" />
                        <Label Text="{Binding DateDisplay}" FontSize="12" TextColor="#526057" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="MESSAGE DETAILS" FontSize="12" FontAttributes="Bold" TextColor="#68756D" />
                    <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="16">
                        <Label Text="{Binding Message}" FontSize="14" TextColor="#26332B"
                               LineHeight="1.4" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
