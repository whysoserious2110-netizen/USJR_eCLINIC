<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.NotificationDetailPage"
             x:DataType="vm:NotificationDetailViewModel"
             BackgroundColor="#F7F8FA">

    <VerticalStackLayout Padding="20,50,20,20" Spacing="18">

        <Grid ColumnDefinitions="Auto,*">
            <Label Grid.Column="0" Text="&#8592;" FontSize="22" TextColor="#0F9B8E" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Notification" FontSize="20" FontAttributes="Bold"
                   TextColor="#12212E" Margin="10,0,0,0" VerticalOptions="Center"/>
        </Grid>

        <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14" Padding="18" HasShadow="False">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" TextColor="#12212E"/>
                <Label Text="{Binding DateDisplay}" FontSize="12" TextColor="#9AA4AE"/>
                <BoxView HeightRequest="1" BackgroundColor="#EEF1F3" Margin="0,4,0,4"/>
                <Label Text="{Binding Message}" FontSize="14" TextColor="#4A5560" LineHeight="1.4"/>
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>