<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="Change Password" BackgroundColor="#F7F8F6" NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout Padding="22,12,22,24" Spacing="16">
        <Grid RowDefinitions="Auto,5" Margin="-22,-12,-22,6">
            <Grid Grid.Row="0" ColumnDefinitions="48,*" BackgroundColor="#176B38" Padding="22,13">
                <Button Text="&#8592;" FontSize="22" TextColor="#087A3D" BackgroundColor="#F4C400"
                        CornerRadius="10" WidthRequest="40" HeightRequest="40" Padding="0" Command="{Binding CancelCommand}"/>
                <Label Grid.Column="1" Text="Change Password" FontSize="18" FontAttributes="Bold" TextColor="#F4C400"
                       Margin="10,0,0,0" VerticalOptions="Center"/>
            </Grid>
            <BoxView Grid.Row="1" Color="#F4C400"/>
        </Grid>
        <Border BackgroundColor="White" Stroke="#DCE5DD" StrokeShape="RoundRectangle 16" Padding="18">
            <VerticalStackLayout Spacing="12">
                <Label Text="Verify your identity" FontSize="19" FontAttributes="Bold" TextColor="#17212B"/>
                <Label Text="Use at least 8 characters with uppercase, lowercase, a number, and a special character." FontSize="13" TextColor="#667085"/>
                <Label Text="Current password" FontAttributes="Bold" FontSize="13" TextColor="#344054"/>
                <Entry Text="{Binding CurrentPassword}" IsPassword="True" Placeholder="Enter current password"/>
                <Label Text="New password" FontAttributes="Bold" FontSize="13" TextColor="#344054"/>
                <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Enter new password"/>
                <Label Text="Confirm new password" FontAttributes="Bold" FontSize="13" TextColor="#344054"/>
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Re-enter new password"/>
                <Button Text="Update Password" Command="{Binding ChangeCommand}" BackgroundColor="#087A3D"
                        TextColor="White" FontAttributes="Bold" CornerRadius="14" HeightRequest="50"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
