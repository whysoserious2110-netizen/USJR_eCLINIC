<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.PostAnnouncementPage"
             x:DataType="vm:PostAnnouncementViewModel"
             BackgroundColor="#F5F7F9">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="18">
                        <Grid RowDefinitions="Auto,5" RowSpacing="0">
                <Border Grid.Row="0" BackgroundColor="#176B38" StrokeThickness="0"
                        StrokeShape="Rectangle" Padding="12,10">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="&#8592;"
                                FontSize="21" TextColor="#087A3D"
                                BackgroundColor="#F4C400" CornerRadius="9"
                                WidthRequest="38" HeightRequest="38" Padding="0"
                                Command="{Binding GoBackCommand}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Post Announcement" FontSize="18"
                                   FontAttributes="Bold" TextColor="#F4C400" />
                            <Label Text="Clinic update" FontSize="11" TextColor="#E9F3EC" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <BoxView Grid.Row="1" Color="#F4C400" />
            </Grid>
            <Border BackgroundColor="#E8F6F4"
                    Stroke="#BFE8E3"
                    StrokeThickness="1"
                    Padding="14"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Posted by the R.E.A.D.S. Scholar"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#087F75" />
                    <Label 
                           FontSize="12"
                           TextColor="#42615F" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Who should see this?"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#172B3A" />
                <Border BackgroundColor="White"
                        Stroke="#DDE4E9"
                        StrokeThickness="1"
                        Padding="10,2"
                        StrokeShape="RoundRectangle 12">
                    <Picker Title="Select audience"
                            ItemsSource="{Binding TargetRoles}"
                            SelectedItem="{Binding SelectedTargetRole}"
                            TextColor="#172B3A" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Announcement message"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#172B3A" />
                <Border BackgroundColor="White"
                        Stroke="#DDE4E9"
                        StrokeThickness="1"
                        Padding="12"
                        StrokeShape="RoundRectangle 12">
                    <Editor Placeholder="Write a clear clinic update..."
                            Text="{Binding Message}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="140"
                            TextColor="#172B3A" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Post announcement"
                    Command="{Binding PostCommand}"
                    BackgroundColor="#087A3D"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="52" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
