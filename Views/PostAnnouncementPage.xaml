<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.PostAnnouncementPage"
             x:DataType="vm:PostAnnouncementViewModel"
             BackgroundColor="#F5F7F9">

    <ScrollView>
        <VerticalStackLayout Padding="20,42,20,24" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="‹"
                        Command="{Binding GoBackCommand}"
                        FontSize="28"
                        TextColor="#078F83"
                        BackgroundColor="Transparent"
                        Padding="4,0"
                        HeightRequest="44"
                        WidthRequest="40" />
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="Post Announcement"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#172B3A" />
                    <Label Text="Clinic update"
                           FontSize="13"
                           TextColor="#687887" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="#E8F6F4"
                    Stroke="#BFE8E3"
                    StrokeThickness="1"
                    Padding="14"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Posted by the R.E.A.D.S. Scholar"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#087F75" />
                    <Label 
                           FontSize="12"
                           TextColor="#42615F" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Who should see this?"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#172B3A" />
                <Border BackgroundColor="White"
                        Stroke="#DDE4E9"
                        StrokeThickness="1"
                        Padding="10,2"
                        StrokeShape="RoundRectangle 12">
                    <Picker Title="Select audience"
                            ItemsSource="{Binding TargetRoles}"
                            SelectedItem="{Binding SelectedTargetRole}"
                            TextColor="#172B3A" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Announcement message"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#172B3A" />
                <Border BackgroundColor="White"
                        Stroke="#DDE4E9"
                        StrokeThickness="1"
                        Padding="12"
                        StrokeShape="RoundRectangle 12">
                    <Editor Placeholder="Write a clear clinic update..."
                            Text="{Binding Message}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="140"
                            TextColor="#172B3A" />
                </Border>
            </VerticalStackLayout>

            <Button Text="Post announcement"
                    Command="{Binding PostCommand}"
                    BackgroundColor="#079B8E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="52" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
