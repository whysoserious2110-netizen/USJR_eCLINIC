<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             xmlns:conv="clr-namespace:USJR_eCLINIC.Converters"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="USJR_eCLINIC.Views.BookAppointmentPage"
             x:Name="Root"
             x:DataType="vm:BookAppointmentViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <conv:ChipBgConverter x:Key="ChipBg" />
        <conv:ChipBorderConverter x:Key="ChipBorder" />
        <conv:ChipTextConverter x:Key="ChipText" />
        <conv:InverseBoolToBoolConverter x:Key="NotBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto,Auto" BackgroundColor="White">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="0,50,0,16" Spacing="0">

                <!-- Green title bar with the yellow brand accent. -->
                <Grid RowDefinitions="Auto,8" Margin="0,-50,0,16">
                    <Border Grid.Row="0"
                            BackgroundColor="#2C9057"
                            StrokeThickness="0"
                            StrokeShape="Rectangle"
                            Padding="20,50,20,16">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="&#8592;"
                                    FontSize="22"
                                    TextColor="#087A3D"
                                    BackgroundColor="#F4C400"
                                    CornerRadius="10"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    Command="{Binding GoBackCommand}"
                                    VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Request Appointment"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#F4C400"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <BoxView Grid.Row="1"
                             HeightRequest="8"
                             BackgroundColor="#F4C400" />
                </Grid>

                <VerticalStackLayout Padding="20,0,20,20" Spacing="16">

                    <!-- Service Type -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Service Type"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#17221B" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Frame BackgroundColor="{Binding SelectedServiceType, Converter={StaticResource ChipBg}, ConverterParameter='Medical'}"
                                   BorderColor="{Binding SelectedServiceType, Converter={StaticResource ChipBorder}, ConverterParameter='Medical'}"
                                   CornerRadius="18" Padding="12,7" Margin="0,0,7,7" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectServiceTypeCommand}" CommandParameter="Medical" />
                                </Frame.GestureRecognizers>
                                <Label Text="Medical" FontSize="12" FontAttributes="Bold"
                                       TextColor="{Binding SelectedServiceType, Converter={StaticResource ChipText}, ConverterParameter='Medical'}" />
                            </Frame>

                            <Frame BackgroundColor="{Binding SelectedServiceType, Converter={StaticResource ChipBg}, ConverterParameter='Dental'}"
                                   BorderColor="{Binding SelectedServiceType, Converter={StaticResource ChipBorder}, ConverterParameter='Dental'}"
                                   CornerRadius="18" Padding="12,7" Margin="0,0,7,7" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectServiceTypeCommand}" CommandParameter="Dental" />
                                </Frame.GestureRecognizers>
                                <Label Text="Dental" FontSize="12" FontAttributes="Bold"
                                       TextColor="{Binding SelectedServiceType, Converter={StaticResource ChipText}, ConverterParameter='Dental'}" />
                            </Frame>

                            <Frame BackgroundColor="{Binding SelectedServiceType, Converter={StaticResource ChipBg}, ConverterParameter='Follow-up'}"
                                   BorderColor="{Binding SelectedServiceType, Converter={StaticResource ChipBorder}, ConverterParameter='Follow-up'}"
                                   CornerRadius="18" Padding="12,7" Margin="0,0,7,7" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectServiceTypeCommand}" CommandParameter="Follow-up" />
                                </Frame.GestureRecognizers>
                                <Label Text="Follow-up" FontSize="12" FontAttributes="Bold"
                                       TextColor="{Binding SelectedServiceType, Converter={StaticResource ChipText}, ConverterParameter='Follow-up'}" />
                            </Frame>

                            <Frame BackgroundColor="{Binding SelectedServiceType, Converter={StaticResource ChipBg}, ConverterParameter='Cert Request'}"
                                   BorderColor="{Binding SelectedServiceType, Converter={StaticResource ChipBorder}, ConverterParameter='Cert Request'}"
                                   CornerRadius="18" Padding="12,7" Margin="0,0,7,7" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectServiceTypeCommand}" CommandParameter="Cert Request" />
                                </Frame.GestureRecognizers>
                                <Label Text="Certificate Request" FontSize="12" FontAttributes="Bold"
                                       TextColor="{Binding SelectedServiceType, Converter={StaticResource ChipText}, ConverterParameter='Cert Request'}" />
                            </Frame>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Medical reason -->
                    <VerticalStackLayout IsVisible="{Binding IsMedical}" Spacing="7">
                        <Label Text="Reason for Visit" FontSize="13" FontAttributes="Bold" TextColor="#17221B" />
                        <Frame BackgroundColor="#F4C400" BorderColor="#087A3D" CornerRadius="12"
                               Padding="12,0" HeightRequest="50" HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#9998;" FontSize="19" TextColor="#087A3D" VerticalOptions="Center" />
                                <Picker Grid.Column="1" ItemsSource="{Binding MedicalReasons}"
                                        SelectedItem="{Binding SelectedMedicalReason}"
                                        Title="Select reason for visit" TextColor="#24342B"
                                        TitleColor="#526057" BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>

                        <VerticalStackLayout IsVisible="{Binding ShowOtherReason}" Spacing="7" Margin="0,8,0,0">
                            <Label Text="Please describe your reason for visit" FontSize="13" FontAttributes="Bold" TextColor="#17221B" />
                            <Frame BackgroundColor="White" BorderColor="#DCE5DD" CornerRadius="12" Padding="12,8" HasShadow="False">
                                <Editor Placeholder="Describe your reason..." Text="{Binding OtherReasonText}"
                                        HeightRequest="76" TextColor="#24342B" />
                            </Frame>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Dental service selection -->
                    <VerticalStackLayout IsVisible="{Binding IsDental}" Spacing="7">
                        <Label Text="Reason for Visit" FontSize="13" FontAttributes="Bold" TextColor="#17221B" />
                        <Frame BackgroundColor="#F4C400" BorderColor="#087A3D" CornerRadius="12"
                               Padding="12,0" HeightRequest="50" HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#9998;" FontSize="19" TextColor="#087A3D" VerticalOptions="Center" />
                                <Picker Grid.Column="1" ItemsSource="{Binding DentalServices}"
                                        SelectedItem="{Binding SelectedDentalService}"
                                        Title="Select dental service" TextColor="#24342B"
                                        TitleColor="#526057" BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Walk-in dental consultation -->
                    <Frame IsVisible="{Binding IsDentalConsultation}"
                           BackgroundColor="#FFF8D8" BorderColor="#E8CF5A"
                           CornerRadius="14" Padding="14" HasShadow="False">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Dental Consultation" FontAttributes="Bold" FontSize="15" TextColor="#17221B" />
                            <Label Text="Walk-in consultation. No appointment is required — please visit the clinic during operating hours."
                                   FontSize="13" TextColor="#526057" />
                            <Button Text="View Clinic Hours" BackgroundColor="#087A3D" TextColor="White"
                                    CornerRadius="12" HeightRequest="42" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Follow-up -->
                    <VerticalStackLayout IsVisible="{Binding IsFollowUp}" Spacing="7">
                        <Label Text="Follow-Up Reason" FontSize="13" FontAttributes="Bold" TextColor="#17221B" />
                        <Frame BackgroundColor="#F4C400" BorderColor="#087A3D" CornerRadius="12"
                               Padding="12,0" HeightRequest="50" HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#9998;" FontSize="19" TextColor="#087A3D" VerticalOptions="Center" />
                                <Picker Grid.Column="1" ItemsSource="{Binding FollowUpReasons}"
                                        SelectedItem="{Binding SelectedFollowUpReason}"
                                        Title="Select follow-up reason" TextColor="#24342B"
                                        TitleColor="#526057" BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                        <Label Text="Additional Notes" FontSize="13" FontAttributes="Bold" TextColor="#17221B" Margin="0,8,0,0" />
                        <Frame BackgroundColor="White" BorderColor="#DCE5DD" CornerRadius="12" Padding="12,8" HasShadow="False">
                            <Editor Placeholder="Additional notes (optional)" Text="{Binding AdditionalNotes}"
                                    HeightRequest="72" TextColor="#24342B" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Certificate request -->
                    <VerticalStackLayout IsVisible="{Binding IsCertRequest}" Spacing="7">
                        <Label Text="Paper Certificate Type" FontSize="13" FontAttributes="Bold" TextColor="#17221B" />
                        <Frame BackgroundColor="#F4C400" BorderColor="#087A3D" CornerRadius="12"
                               Padding="12,0" HeightRequest="50" HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#9998;" FontSize="19" TextColor="#087A3D" VerticalOptions="Center" />
                                <Picker Grid.Column="1" ItemsSource="{Binding CertificateTypes}"
                                        SelectedItem="{Binding SelectedCertificateType}"
                                        Title="Select certificate type" TextColor="#24342B"
                                        TitleColor="#526057" BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                        <Label Text="Purpose / Reason for Request" FontSize="13" FontAttributes="Bold" TextColor="#17221B" Margin="0,8,0,0" />
                        <Frame BackgroundColor="White" BorderColor="#DCE5DD" CornerRadius="12" Padding="12,8" HasShadow="False">
                            <Editor Placeholder="Why do you need this certificate?" Text="{Binding CertificatePurpose}"
                                    HeightRequest="72" TextColor="#24342B" />
                        </Frame>
                        <Label Text="R.E.A.D.S. reviews the appointment request. The doctor or dentist reviews the certificate after your clinic visit; the clinic provides a paper copy."
                               FontSize="11" TextColor="#68756D" Margin="0,3,0,0" />
                    </VerticalStackLayout>

                    <!-- Date and time selection -->
                    <VerticalStackLayout IsVisible="{Binding ShowDateTimeSection}" Spacing="8">
                        <Label Text="Select Date" FontSize="13" FontAttributes="Bold" TextColor="#17221B" />
                        <Frame BackgroundColor="White" BorderColor="#DCE5DD" CornerRadius="12"
                               Padding="12,0" HeightRequest="50" HasShadow="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#128197;" FontSize="17" TextColor="#8B9DB5" VerticalOptions="Center" />
                                <DatePicker Grid.Column="1" Date="{Binding PickerDate}"
                                            MinimumDate="{x:Static system:DateTime.Today}"
                                            TextColor="#526057" BackgroundColor="Transparent"
                                            VerticalOptions="Center" />
                            </Grid>
                        </Frame>

                        <Label Text="{Binding DateDisplayText}" FontSize="12" TextColor="#087A3D"
                               FontAttributes="Bold" IsVisible="{Binding HasSelectedDate}" />

                        <Label Text="Select Time Slot" FontSize="13" FontAttributes="Bold" TextColor="#17221B"
                               Margin="0,7,0,0" IsVisible="{Binding HasSelectedDate}" />
                        <Frame BackgroundColor="White" BorderColor="#DCE5DD" CornerRadius="12"
                               Padding="12,0" HeightRequest="50" HasShadow="False"
                               IsVisible="{Binding HasSelectedDate}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#9719;" FontSize="18" TextColor="#8B9DB5" VerticalOptions="Center" />
                                <Picker Grid.Column="1" ItemsSource="{Binding AvailableTimeOptions}"
                                        SelectedItem="{Binding SelectedTimeOption}"
                                        Title="Select time slot" TextColor="#526057"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Keep the primary action above the bottom navigation. -->
        <Button Grid.Row="1"
                Text="Request Appointment"
                Command="{Binding ConfirmCommand}"
                IsVisible="{Binding IsDentalConsultation, Converter={StaticResource NotBool}}"
                BackgroundColor="#176519"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="13"
                HeightRequest="50"
                Margin="24,8,24,10" />

        <!-- Student bottom navigation -->
        <Grid Grid.Row="2" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" Color="#E7EBEF" HeightRequest="1" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,8,0,5">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#8962;" FontSize="20" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#0F9B8E" HorizontalOptions="Center" />
                    <Label Text="Appointments" FontSize="10" FontAttributes="Bold" TextColor="#0F9B8E" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128276;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Notifications" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#94A3B8" HorizontalOptions="Center" />
                    <Label Text="Profile" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>

