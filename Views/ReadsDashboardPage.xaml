<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
             x:Class="USJR_eCLINIC.Views.ReadsDashboardPage"
             x:Name="Root"
             x:DataType="vm:ReadsDashboardViewModel"
             BackgroundColor="#F7F8FA">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,50,20,20" Spacing="18">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Welcome," FontSize="13" TextColor="#6B7684"/>
                        <Label Text="{Binding StaffName}" FontSize="19" FontAttributes="Bold" TextColor="#12212E"/>
                        <Frame BackgroundColor="#D5F5EF" Padding="10,3" CornerRadius="10"
                               HasShadow="False" HorizontalOptions="Start" Margin="0,4,0,0">
                            <Label Text="R.E.A.D.S. SCHOLAR" FontSize="11" FontAttributes="Bold" TextColor="#0F9B8E"/>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>

                <Frame IsVisible="{Binding HasAnnouncement}"
                       BackgroundColor="#FFF6DC"
                       BorderColor="#F3D67A"
                       CornerRadius="12"
                       Padding="14"
                       HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="&#9432;" FontSize="18" TextColor="#B8862B" VerticalOptions="Start"/>
                        <Label Grid.Column="1" Text="{Binding AnnouncementText}" FontSize="13" TextColor="#5A4A1E"/>
                    </Grid>
                </Frame>

                <!-- Priority: Search Patient -->
                <Label Text="Front Desk Tools" FontSize="17" FontAttributes="Bold" TextColor="#12212E" Margin="0,6,0,0"/>

                <Frame BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToPatientSearchCommand}"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*">
                        <Frame Grid.Column="0" BackgroundColor="#D5F5EF" CornerRadius="10" Padding="10" WidthRequest="44" HeightRequest="44" HasShadow="False">
                            <Label Text="&#128269;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="14,0,0,0" Spacing="2">
                            <Label Text="Search Patient" FontAttributes="Bold" FontSize="15" TextColor="#12212E"/>
                            <Label Text="Look up patients &amp; administrative notes" FontSize="12" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                    
                    <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToTodaysOverviewCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#E6F3FD" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128202;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Today's Overview" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Clinic workload" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPatientRegistrationCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#D5F5EF" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128100;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Register Patient" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Create new patient" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCheckInCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#FEF3D9" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#9989;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Check-In Patient" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Scan ID / QR" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAppointmentManagementCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#FDE6EC" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128197;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Manage Appointments" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Approve requests" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="2" Grid.Column="0" BackgroundColor="White" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPostAnnouncementCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#E6F3FD" CornerRadius="10" Padding="8" WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128227;" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Post Announcement" FontAttributes="Bold" FontSize="14" TextColor="#12212E"/>
                            <Label Text="Clinic-wide notice" FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom nav -->
        <Frame Grid.Row="1" BackgroundColor="White" CornerRadius="0" Padding="0,10" HasShadow="False">
            <Grid ColumnDefinitions="*,*,*,*">

                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="&#8962;" FontSize="18" TextColor="#0F9B8E" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="11" TextColor="#0F9B8E" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAppointmentManagementCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128197;" FontSize="18" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                    <Label Text="Appointments" FontSize="11" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Grid Grid.Column="2" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="&#128276;" FontSize="18" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                        <Label Text="Notifications" FontSize="11" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Frame IsVisible="{Binding HasUnreadNotifications}"
                   BackgroundColor="#E05B5B" CornerRadius="9"
                   WidthRequest="18" HeightRequest="18" Padding="0" HasShadow="False"
                   HorizontalOptions="End" VerticalOptions="Start" Margin="0,-4,8,0">
                        <Label Text="{Binding UnreadNotificationCount}" FontSize="10" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                </Grid>

                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="&#128100;" FontSize="18" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                    <Label Text="Profile" FontSize="11" TextColor="#9AA4AE" HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </Grid>
        </Frame>

    </Grid>
</ContentPage>