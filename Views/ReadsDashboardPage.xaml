<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:USJR_eCLINIC.ViewModels"
    x:Class="USJR_eCLINIC.Views.ReadsDashboardPage"
    x:Name="Root"
    x:DataType="vm:ReadsDashboardViewModel"
    BackgroundColor="#F7F8FA">

    <Grid RowDefinitions="*,Auto">

        <!-- Main scrollable content -->
        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="16,18,16,24"
                Spacing="18">

                <!-- R.E.A.D.S. yellow identity header -->
                <Border BackgroundColor="#F4C400"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Frame Grid.Column="0"
                               WidthRequest="54"
                               HeightRequest="54"
                               CornerRadius="27"
                               Padding="0"
                               HasShadow="False"
                               BackgroundColor="#FFF4C7"
                               IsClippedToBounds="True"
                               VerticalOptions="Center">
                            <Grid>
                                <Label Text="&#128100;"
                                       FontSize="24"
                                       TextColor="#087A3D"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <Image Source="{Binding ProfileImagePath, Converter={StaticResource ImagePathConv}}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill"/>
                            </Grid>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="Adelante, Scholar!"
                                   FontSize="12"
                                   TextColor="#087A3D"/>
                            <Label Text="{Binding StaffName}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#087A3D"/>
                            <Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    Padding="7,3"
                                    HorizontalOptions="Start"
                                    Margin="0,3,0,0">
                                <Label Text="R.E.A.D.S. SCHOLAR"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#087A3D"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <!-- Clinic announcement -->
                <Frame
                    IsVisible="{Binding HasAnnouncement}"
                    BackgroundColor="#FFF6DC"
                    BorderColor="#F3D67A"
                    CornerRadius="12"
                    Padding="14"
                    HasShadow="False">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Text="&#9432;"
                            FontSize="18"
                            TextColor="#B8862B"
                            VerticalOptions="Start"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding AnnouncementText}"
                            FontSize="13"
                            TextColor="#5A4A1E"/>

                    </Grid>

                </Frame>

                <!-- Front Desk Actions -->
                <Label
                    Text="Front Desk Actions"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="#12212E"
                    Margin="0,6,0,0"/>

                <!-- Primary actions: ID check-in, today's operations, patient lookup, and announcements. -->
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="14"
                    RowSpacing="14">

                    <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="White"
                           BorderColor="#E2E6EA" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsOverviewSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FFF4C7"/>
                                <Setter Property="BorderColor" Value="#F4C400"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToTodaysOverviewCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#E6F3FD" CornerRadius="10" Padding="8"
                                   WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128202;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Today's Overview" FontAttributes="Bold"
                                   FontSize="14" TextColor="#12212E"/>
                            <Label Text="Clinic operations" FontSize="11" TextColor="#8793A0"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="White"
                           BorderColor="#E2E6EA" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsCheckInSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FFF4C7"/>
                                <Setter Property="BorderColor" Value="#F4C400"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCheckInCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#D5F5EF" CornerRadius="10" Padding="8"
                                   WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#9989;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Check-In Patient" FontAttributes="Bold"
                                   FontSize="14" TextColor="#12212E"/>
                            <Label Text="Enter or scan ID" FontSize="11" TextColor="#687585"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="White"
                           BorderColor="#E2E6EA" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsPatientLookupSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FFF4C7"/>
                                <Setter Property="BorderColor" Value="#F4C400"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPatientSearchCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#D5F5EF" CornerRadius="10" Padding="8"
                                   WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128269;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Patient Lookup" FontAttributes="Bold"
                                   FontSize="14" TextColor="#12212E"/>
                            <Label Text="Search or register patient" FontSize="11" TextColor="#8793A0"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="White"
                           BorderColor="#E2E6EA" CornerRadius="16" Padding="16" HasShadow="False">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsAnnouncementSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FFF4C7"/>
                                <Setter Property="BorderColor" Value="#F4C400"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPostAnnouncementCommand}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Frame BackgroundColor="#E6F3FD" CornerRadius="10" Padding="8"
                                   WidthRequest="40" HeightRequest="40" HasShadow="False">
                                <Label Text="&#128227;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Post Announcement" FontAttributes="Bold"
                                   FontSize="14" TextColor="#12212E"/>
                            <Label Text="Clinic-wide notice" FontSize="11" TextColor="#8793A0"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>
                <Frame BackgroundColor="White" BorderColor="#E2E6EA" CornerRadius="14"
                       Padding="14" HasShadow="False">
                    <Frame.Triggers>
                        <DataTrigger TargetType="Frame" Binding="{Binding IsCertificatePickupSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="#FFF4C7"/>
                            <Setter Property="BorderColor" Value="#F4C400"/>
                        </DataTrigger>
                    </Frame.Triggers>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCertificatePickupCommand}"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Frame Grid.Column="0" BackgroundColor="#FFF4C7" CornerRadius="10"
                               Padding="8" WidthRequest="42" HeightRequest="42" HasShadow="False">
                            <Label Text="&#128196;" FontSize="19" HorizontalOptions="Center"
                                   VerticalOptions="Center" TextColor="#087A3D"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Issued Certificate" FontSize="14"
                                   FontAttributes="Bold" TextColor="#12212E"/>
                            <Label Text="{Binding ReadyCertificateCount, StringFormat='{0} ready for pickup'}"
                                   FontSize="11" TextColor="#9AA4AE"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#087A3D"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Next Arrivals below Front Desk panels -->
                <VerticalStackLayout
                    Spacing="12"
                    Margin="0,6,0,0">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2">

                            <Label
                                Text="Next Arrivals"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#12212E"/>

                            <Label
                                Text="{Binding NextArrivalsSummary}"
                                FontSize="11"
                                TextColor="#9AA4AE"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="View All →"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#0F9B8E"
                            VerticalOptions="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding GoToTodaysOverviewCommand}"/>
                            </Label.GestureRecognizers>

                        </Label>

                    </Grid>

                    <!-- Empty state -->
                    <Frame
                        IsVisible="{Binding HasNextArrivals,
                            Converter={StaticResource BoolInverter}}"
                        BackgroundColor="White"
                        BorderColor="#E2E6EA"
                        CornerRadius="14"
                        Padding="16"
                        HasShadow="False">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Frame
                                Grid.Column="0"
                                BackgroundColor="#E6F3FD"
                                CornerRadius="10"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="6"
                                HasShadow="False">

                                <Label
                                    Text="&#128197;"
                                    FontSize="21"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                            </Frame>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">

                                <Label
                                    Text="No upcoming visits today"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#6B7684"/>

                                <Label
                                    Text="Confirmed visits scheduled for later today will appear here."
                                    FontSize="11"
                                    TextColor="#9AA4AE"/>

                            </VerticalStackLayout>

                        </Grid>

                    </Frame>

                    <!-- Arrival list -->
                    <VerticalStackLayout
                        IsVisible="{Binding HasNextArrivals}"
                        Spacing="10"
                        BindableLayout.ItemsSource="{Binding NextArrivals}">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="vm:ReadsNextArrivalItem">

                                <Frame
                                    BackgroundColor="White"
                                    BorderColor="#E2E8EF"
                                    CornerRadius="14"
                                    Padding="12"
                                    HasShadow="False">

                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="10">

                                        <!-- Time and arrival timing -->
                                        <Frame Grid.Column="0"
                                               BackgroundColor="#F5F7FA"
                                               CornerRadius="10"
                                               Padding="6"
                                               WidthRequest="68"
                                               HeightRequest="62"
                                               HasShadow="False">
                                            <VerticalStackLayout Spacing="3"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding TimeDisplay}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#12212E"
                                                       HorizontalOptions="Center"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding ArrivalTimeContext}"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding ArrivalTimeContextColor}"
                                                       HorizontalOptions="Center"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Frame>

                                        <!-- Patient and service details -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding PatientName}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#12212E"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding PatientIdNumber}"
                                                   FontSize="10"
                                                   TextColor="#8793A0"
                                                   LineBreakMode="TailTruncation" />
                                            <Label FontSize="11"
                                                   TextColor="#526171"
                                                   LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding ServiceType}"
                                                              FontAttributes="Bold" />
                                                        <Span Text=" · " />
                                                        <Span Text="{Binding SubService}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>


                                    </Grid>

                                </Frame>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Bottom navigation -->
        <Frame
            Grid.Row="1"
            BackgroundColor="White"
            CornerRadius="0"
            Padding="0,10"
            HasShadow="False">

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- Home -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2"
                    HorizontalOptions="Center">

                    <Label
                        Text="&#8962;"
                        FontSize="18"
                        TextColor="#0F9B8E"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Home"
                        FontSize="11"
                        TextColor="#0F9B8E"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- Appointments -->
                <Grid
                    Grid.Column="1"
                    HorizontalOptions="Center">

                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToAppointmentsOverviewCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Label
                            Text="&#128197;"
                            FontSize="18"
                            TextColor="#9AA4AE"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Appointments"
                            FontSize="11"
                            TextColor="#9AA4AE"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                    <Frame
                        IsVisible="{Binding HasPendingApprovals}"
                        BackgroundColor="#E05B5B"
                        CornerRadius="9"
                        WidthRequest="18"
                        HeightRequest="18"
                        Padding="0"
                        HasShadow="False"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,-4,8,0">

                        <Label
                            Text="{Binding PendingApprovalCount}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                    </Frame>

                </Grid>

                <!-- Notifications -->
                <Grid
                    Grid.Column="2"
                    HorizontalOptions="Center">

                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding GoToNotificationsCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Label
                            Text="&#128276;"
                            FontSize="18"
                            TextColor="#9AA4AE"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Notifications"
                            FontSize="11"
                            TextColor="#9AA4AE"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                    <Frame
                        IsVisible="{Binding HasUnreadNotifications}"
                        BackgroundColor="#E05B5B"
                        CornerRadius="9"
                        WidthRequest="18"
                        HeightRequest="18"
                        Padding="0"
                        HasShadow="False"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,-4,8,0">

                        <Label
                            Text="{Binding UnreadNotificationCount}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                    </Frame>

                </Grid>

                <!-- Profile -->
                <VerticalStackLayout
                    Grid.Column="3"
                    Spacing="2"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToProfileCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="&#128100;"
                        FontSize="18"
                        TextColor="#9AA4AE"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Profile"
                        FontSize="11"
                        TextColor="#9AA4AE"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Grid>

        </Frame>

    </Grid>

</ContentPage>

